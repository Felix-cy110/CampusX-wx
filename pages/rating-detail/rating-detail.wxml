<!-- 评分详情页 - 匹配Sketch设计稿 -->
<view class="page">
  <view class="fixed-header">
    <view class="status-bar-placeholder" style="height: {{statusBarHeight}}px;"></view>
    <view class="detail-nav-bar" style="height: {{navBarHeight}}px;">
      <view class="nav-back" bindtap="goBack">
        <image class="nav-back-icon" src="/images/SVG/返回.svg" mode="aspectFit"></image>
      </view>
      <text class="detail-title">评分详情</text>
      <view class="nav-more" style="margin-right: {{capsuleGap}}px;" bindtap="showMoreOptions">
        <text class="nav-more-icon">⋮</text>
      </view>
    </view>
  </view>
  <scroll-view class="content" scroll-y>
    <!-- 用户信息行：头像 + 用户名 + 时间 + 标签 + 关注按钮 -->
    <view class="user-info-row">
      <view class="user-info-left">
        <image class="user-info-avatar" src="{{rating.user.avatar}}" mode="aspectFill" catchtap="goToUserProfile" data-name="{{rating.user.name}}" data-avatar="{{rating.user.avatar}}"></image>
        <view class="user-info-info">
          <text class="user-info-name">{{rating.user.name}}</text>
          <view class="user-info-meta">
            <text class="tag {{rating.type === 'food' ? 'tag-green' : rating.type === 'course' ? 'tag' : 'tag-orange'}}">{{rating.tag}}</text>
            <text class="user-info-time">{{rating.time}}</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 帖子标题 -->
    <text class="post-title">{{rating.title}}</text>

    <!-- 星级评分 -->
    <view class="star-section">
      <view class="stars">
        <text class="star" wx:for="{{starArray}}" wx:key="index">{{item === 'full' ? '★' : item === 'half' ? '★' : '☆'}}</text>
      </view>
      <text class="score-text">{{rating.score}}分</text>
      <text class="score-raters">共{{rating.totalRaters || '3248'}}人评分</text>
    </view>

    <!-- 帖子正文 -->
    <text class="post-body">{{rating.content}}</text>

    <!-- 评论区 -->
    <view class="comments-section">
      <text class="comments-title">评论（{{rating.stats.comments}}）</text>
      <view class="comment-title-divider"></view>
      <view class="empty-state" wx:if="{{comments.length === 0}}">
        <text>暂无评论</text>
      </view>
      <block wx:for="{{comments}}" wx:key="id">
        <view class="comment-block">
        <view class="comment-item">
          <image class="comment-avatar" src="{{item.avatar}}" mode="aspectFill"></image>
          <view class="comment-body">
            <view class="comment-header">
              <text class="comment-name">{{item.name}}</text>
              <text class="comment-time">{{item.time}}</text>
            </view>
            <text class="comment-text">{{item.content}}</text>
            <view class="comment-actions">
              <view class="comment-action" bindtap="toggleCommentLike" data-id="{{item.id}}">
                <text class="comment-action-icon" style="color: {{item.liked ? 'var(--color-red)' : 'var(--color-text-secondary)'}};">❤</text>
                <text class="comment-action-count">{{item.likes || 0}}</text>
              </view>
              <view class="comment-action" bindtap="replyComment" data-id="{{item.id}}">
                <text class="comment-action-icon">💬</text>
                <text class="comment-action-count">{{item.replies ? item.replies.length : 0}}</text>
              </view>
            </view>
          </view>
        </view>
        <view class="comment-replies" wx:if="{{item.replies && item.replies.length > 0}}">
        <view class="comment-reply" wx:for="{{item.replies}}" wx:for-item="reply" wx:key="id">
          <view class="comment-body">
            <view class="comment-header">
              <text class="comment-name">{{reply.name}}</text>
              <text wx:if="{{reply.replyTo}}">
                <text class="comment-reply-label"> 回复 </text>
                <text class="comment-reply-to">{{reply.replyTo}}</text>
              </text>
              <text class="comment-text reply-inline">  {{reply.content}}</text>
              <text class="comment-time">{{reply.time}}</text>
            </view>
          </view>
        </view>
        </view>
        </view>
      </block>
    </view>
  </scroll-view>

  <!-- 底部输入栏 -->
  <view class="bottom-bar">
    <input class="bottom-comment-input" placeholder="输入评论" placeholder-class="input-placeholder" />
    <view class="bottom-action-group">
      <view class="bottom-action" bindtap="toggleLike">
        <text class="bottom-action-icon" style="color: {{rating.isLiked ? 'var(--color-red)' : 'var(--color-text-secondary)'}};">❤</text>
        <text class="bottom-action-count">{{rating.stats.likes}}</text>
      </view>
      <view class="bottom-action" bindtap="toggleFavorite">
        <text class="bottom-action-icon" style="color: {{isFavorited ? 'var(--color-star)' : 'var(--color-text-secondary)'}};">⭐</text>
        <text class="bottom-action-count">{{rating.stats.comments}}</text>
      </view>
      <button class="bottom-action share-native-button" open-type="share">
        <image class="share-action-icon" src="/images/SVG/转发.svg" mode="aspectFit"></image>
        <text class="bottom-action-count">分享</text>
      </button>
    </view>
    <view class="bottom-plus-btn" bindtap="addComment">
      <text class="plus-icon">+</text>
    </view>
  </view>
</view>
