<!-- 评论和@ -->
<view class="page-container">
  <view class="status-bar-placeholder" style="height: {{statusBarHeight}}px;"></view>
  <view class="nav-bar" style="height: {{navBarHeight}}px;">
    <image class="nav-back" src="/images/SVG/返回.svg" mode="aspectFit" bindtap="navigateBack"></image>
    <text class="nav-title">评论和@</text>
    <view class="nav-placeholder"></view>
  </view>

  <scroll-view class="comment-list" wx:if="{{commentList.length > 0}}" scroll-y enhanced show-scrollbar="{{false}}" bindscrolltolower="onScrollToLower" lower-threshold="100">
    <view
      wx:for="{{commentList}}"
      wx:key="cursorId"
      class="comment-item"
      data-post-id="{{item.postId}}"
      bindtap="onItemTap"
      hover-class="comment-item-hover"
      hover-stay-time="80"
    >
      <!-- 用户头像 -->
      <view class="user-avatar">
        <image wx:if="{{item.avatar}}" class="avatar-img" src="{{item.avatar}}" mode="aspectFill"></image>
        <text wx:else class="avatar-text">{{item.name[0]}}</text>
      </view>

      <!-- 内容区 -->
      <view class="comment-content">
        <view class="comment-header">
          <text class="user-name">{{item.name}}</text>
          <text class="action-type {{item.action === '评论了你' ? 'type-comment' : 'type-mention'}}">{{item.action}}</text>
          <text class="comment-time">{{item.time}}</text>
        </view>
        <view wx:if="{{item.content}}" class="comment-body">
          <text class="content-text">{{item.content}}</text>
        </view>
        <view wx:if="{{item.postTitle}}" class="comment-ref">
          <text class="ref-label">帖子：</text>
          <text class="ref-text ellipsis-2">{{item.postTitle}}</text>
        </view>
      </view>
    </view>
    <view class="loading-tip" wx:if="{{loading}}">
      <text>加载中...</text>
    </view>
    <view class="loading-tip" wx:if="{{!hasMore && commentList.length > 0}}">
      <text>没有更多了</text>
    </view>
  </scroll-view>

  <view wx:if="{{commentList.length === 0 && !loading}}" class="empty-state">
    <view class="empty-icon-wrap">
      <image class="empty-icon" src="/images/SVG/评论.svg" mode="aspectFit"></image>
    </view>
    <text class="empty-title">暂无评论</text>
    <text class="empty-desc">当有人评论或提到你时，会显示在这里</text>
  </view>
</view>
