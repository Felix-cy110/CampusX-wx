<view class="page">
  <!-- 自定义导航栏 -->
  <view class="fixed-header">
    <view class="status-bar-placeholder" style="height: {{statusBarHeight}}px;"></view>
    <view class="nav-bar" style="height: {{navBarHeight}}px; padding-right: {{capsuleGap}}px;">
      <view class="nav-back" bindtap="goBack">
        <image class="nav-back-icon" src="/images/SVG/返回.svg" mode="aspectFit"></image>
      </view>
      <text class="nav-title">{{orderId ? '跑腿订单详情' : '跑腿详情'}}</text>
      <view class="nav-share">
        <button wx:if="{{!orderId}}" class="share-nav-button" size="mini" open-type="share">
          <image class="share-nav-icon" src="/images/SVG/转发.svg" mode="aspectFit"></image>
        </button>
      </view>
    </view>
  </view>

  <scroll-view class="content" style="padding-top: {{statusBarHeight + navBarHeight}}px;" scroll-y enhanced show-scrollbar="{{false}}" wx:if="{{!loading && demand}}">
    <!-- 发布者信息 + 课程信息 + 提示 -->
    <view class="info-card">
      <view class="info-block" wx:if="{{order}}">
        <text class="order-status">{{order.statusDesc}}</text>
        <view class="order-meta"><text>订单号：{{order.orderNo}}</text></view>
        <view class="order-meta"><text>创建时间：{{order.createdAt}}</text></view>
      </view>
      <!-- 发布者信息 -->
      <view class="info-block">
        <view class="contact-role" wx:if="{{order}}"><text>{{order.contactRole}}</text></view>
        <view class="user-row" bindtap="goToUserProfile">
          <image class="user-avatar" src="{{demand.user.avatar}}" mode="aspectFill"></image>
          <view class="user-info">
            <text class="user-name">{{demand.user.name}}</text>
            <text class="user-time">{{demand.time}}</text>
          </view>
          <view class="contact-btn" catchtap="contactUser">
            <text>联系TA</text>
          </view>
        </view>
      </view>

      <!-- 课程信息 -->
      <view class="info-block">
        <view class="course-title-row">
          <text class="course-title">{{demand.title}}</text>
          <view class="fee-tag">
            <text class="fee-label">报酬</text>
            <text class="fee-amount">￥{{demand.reward}}</text>
          </view>
        </view>
        <view class="detail-content">
          <text class="detail-text">{{demand.content}}</text>
        </view>
      </view>

      <!-- 仅限本校提示 -->
      <view class="info-block" wx:if="{{demand._raw && demand._raw.onlySameSchool}}">
        <view class="info-tip">
          <text>⚠️ 仅限本校学生接单</text>
        </view>
      </view>
    </view>
  </scroll-view>

  <!-- 加载中 / 空状态 -->
  <view class="empty-container" wx:if="{{loading}}">
    <text>加载中...</text>
  </view>
  <view class="empty-container" wx:if="{{!loading && !demand}}">
    <text>{{loadError || '数据不存在'}}</text>
    <button wx:if="{{loadError}}" class="retry-btn" bindtap="retryLoad">重新加载</button>
  </view>

  <!-- 底部下单按钮 -->
  <view class="bottom-bar" wx:if="{{!loading && demand && !orderId}}">
    <view class="bottom-btn {{applying ? 'disabled' : ''}}" bindtap="applyOrder">
      <text>{{demand.type === 'supply' ? '联系TA' : (applying ? '下单中...' : '下单')}}</text>
    </view>
  </view>

  <view class="bottom-bar" wx:if="{{!loading && order}}">
    <view class="bottom-btn" bindtap="viewOrders"><text>返回订单列表</text></view>
  </view>

  <view class="safe-bottom-spacer"></view>
</view>
