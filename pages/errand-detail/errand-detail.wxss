/* 跑腿详情页样式 */

.page {
  min-height: 100vh;
  background-color: var(--color-bg, #F5F5F5);
  display: flex;
  flex-direction: column;
}

/* 导航栏 */
.fixed-header {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
  background-color: #FFFFFF;
}

.status-bar-placeholder {
  width: 100%;
}

.nav-bar {
  display: flex;
  align-items: center;
  padding: 0 16rpx;
  box-sizing: border-box;
}

.nav-back {
  width: 80rpx;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.nav-back-icon {
  width: 40rpx;
  height: 40rpx;
}

.nav-title {
  flex: 1;
  text-align: left;
  font-size: var(--font-lg, 32rpx);
  font-weight: 600;
  color: var(--color-text-primary, #1A1A1A);
}

.nav-placeholder {
  width: 80rpx;
}

.share-nav-button {
  margin: 0;
  padding: 0;
  border: 0;
  background: transparent;
  line-height: normal;
  display: flex;
  align-items: center;
  justify-content: center;
}

.share-nav-button::after {
  border: 0;
}

.share-nav-icon {
  width: 36rpx;
  height: 36rpx;
}

/* 内容区 */
.content {
  flex: 1;
  padding-bottom: 120rpx;
}

/* 信息卡片 - 左右撑满 */
.info-card {
  width: 100%;
  background-color: #FFFFFF;
  box-sizing: border-box;
}

/* 信息区块 */
.info-block {
  background-color: #FFFFFF;
  padding: 30rpx;
}

.info-block + .info-block {
  border-top: 1rpx solid #F0F0F0;
}

/* 用户行 */
.user-row {
  display: flex;
  align-items: center;
}

.user-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.user-info {
  flex: 1;
  margin-left: 20rpx;
  display: flex;
  flex-direction: column;
}

.user-name {
  font-size: var(--font-md, 28rpx);
  font-weight: 600;
  color: var(--color-text-primary, #1A1A1A);
}

.user-time {
  font-size: var(--font-xs, 24rpx);
  color: var(--color-text-secondary, #999999);
  margin-top: 6rpx;
}

.contact-btn {
  padding: 12rpx 28rpx;
  border-radius: 40rpx;
  border: 2rpx solid var(--color-primary, #255AC5);
  flex-shrink: 0;
}

.contact-btn text {
  font-size: var(--font-sm, 26rpx);
  color: var(--color-primary, #255AC5);
}

/* 课程标题行 */
.course-title-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}

.course-title {
  flex: 1;
  font-size: var(--font-xl, 36rpx);
  font-weight: 700;
  color: var(--color-text-primary, #1A1A1A);
  line-height: 1.4;
}

.fee-tag {
  display: flex;
  flex-direction: column;
  align-items: center;
  background-color: #FFF3E0;
  border-radius: var(--radius-sm, 8rpx);
  padding: 12rpx 20rpx;
  margin-left: 20rpx;
  flex-shrink: 0;
}

.fee-label {
  font-size: var(--font-xs, 22rpx);
  color: #E65100;
}

.fee-amount {
  font-size: var(--font-lg, 32rpx);
  font-weight: 700;
  color: var(--color-orange, #FF6B00);
  margin-top: 4rpx;
}

/* 详情内容 */
.detail-content {
  margin-top: 24rpx;
}

.detail-text {
  font-size: var(--font-md, 28rpx);
  color: var(--color-text-secondary, #666666);
  line-height: 1.8;
  white-space: pre-line;
}

/* 提示信息 */
.info-tip {
  padding: 16rpx 20rpx;
  background-color: #FFF8E1;
  border-radius: var(--radius-sm, 8rpx);
}

.info-tip text {
  font-size: var(--font-sm, 26rpx);
  color: #F57F17;
}

/* 空状态 */
.empty-container {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  padding-top: calc(var(--navBarHeight, 44px) + var(--statusBarHeight, 20px));
}

.empty-container text {
  font-size: var(--font-md, 28rpx);
  color: var(--color-text-secondary, #999999);
}

/* 底部下单栏 */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 16rpx 30rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  background-color: #FFFFFF;
  box-shadow: 0 -2rpx 10rpx rgba(0, 0, 0, 0.05);
  z-index: 100;
}

.bottom-btn {
  width: 100%;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: var(--color-primary, #255AC5);
  border-radius: var(--radius-md, 16rpx);
}

.bottom-btn text {
  font-size: var(--font-lg, 32rpx);
  font-weight: 600;
  color: #FFFFFF;
}

.bottom-btn.disabled {
  opacity: 0.6;
}

.safe-bottom-spacer {
  height: calc(120rpx + env(safe-area-inset-bottom));
}
