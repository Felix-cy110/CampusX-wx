<!-- 关注与粉丝 -->
<view class="page">
  <view class="fixed-header">
    <view style="height: {{statusBarHeight}}px; background: #fff;"></view>
    <view class="nav-bar" style="height: {{navBarHeight}}px;">
      <view class="nav-back" bindtap="goBack">
        <image class="nav-back-icon" src="/images/SVG/返回.svg" mode="aspectFit"></image>
      </view>
      <text class="nav-title">关注与粉丝</text>
      <view style="width: 80rpx;"></view>
    </view>
  </view>
  <!-- Tab 切换栏 -->
  <view class="tab-bar">
    <view class="tab-item {{currentTab === 'following' ? 'active' : ''}}" bindtap="switchTab" data-tab="following">
      <text>关注</text>
    </view>
    <view class="tab-item {{currentTab === 'follower' ? 'active' : ''}}" bindtap="switchTab" data-tab="follower">
      <text>粉丝</text>
    </view>
  </view>

  <!-- 关注列表 -->
  <scroll-view class="user-list" wx:if="{{currentTab === 'following'}}" scroll-y enhanced show-scrollbar="{{false}}" bindscrolltolower="onFollowingScrollToLower" lower-threshold="100">
    <view class="user-item" wx:for="{{followingList}}" wx:key="uid">
      <image class="user-avatar" src="{{item.avatar}}" mode="aspectFill" catchtap="goToUserProfile" data-uid="{{item.uid}}" data-name="{{item.name}}" data-avatar="{{item.avatar}}"></image>
      <text class="user-name flex-1 ml-20">{{item.name}}</text>
      <view class="follow-btn {{item.isFollowed ? 'followed' : ''}}" catchtap="toggleFollow" data-index="{{index}}">
        <text>{{item.isFollowed ? '已关注' : '关注'}}</text>
      </view>
    </view>

    <view class="loading-tip" wx:if="{{followingLoading}}">
      <text>加载中...</text>
    </view>

    <view class="empty-state" wx:if="{{followingList.length === 0 && !followingLoading}}">
      <text>暂无关注</text>
    </view>
  </scroll-view>

  <!-- 粉丝列表 -->
  <scroll-view class="user-list" wx:if="{{currentTab === 'follower'}}" scroll-y enhanced show-scrollbar="{{false}}" bindscrolltolower="onFollowingScrollToLower" lower-threshold="100">
    <view class="user-item" wx:for="{{followerList}}" wx:key="uid">
      <image class="user-avatar" src="{{item.avatar}}" mode="aspectFill" catchtap="goToUserProfile" data-uid="{{item.uid}}" data-name="{{item.name}}" data-avatar="{{item.avatar}}"></image>
      <text class="user-name flex-1 ml-20">{{item.name}}</text>
      <view class="follow-btn {{item.isMutual ? 'followed' : ''}}" catchtap="toggleFollowerFollow" data-index="{{index}}">
        <text>{{item.isMutual ? '互关' : '关注'}}</text>
      </view>
    </view>

    <view class="loading-tip" wx:if="{{followerLoading}}">
      <text>加载中...</text>
    </view>

    <view class="empty-state" wx:if="{{followerList.length === 0 && !followerLoading}}">
      <text>暂无粉丝</text>
    </view>
  </scroll-view>

  <view class="bottom-safe"></view>
</view>
