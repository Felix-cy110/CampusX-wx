.page {
  min-height: 100vh;
  background-color: var(--color-bg);
  padding-bottom: 40rpx;
}

.status-bar-placeholder {
  width: 100%;
  background-color: #FFFFFF;
}

/* 导航栏 */
.nav-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 20rpx;
  background-color: #FFFFFF;
  border-bottom: 1rpx solid var(--color-border-light);
  box-sizing: border-box;
}

.nav-back {
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.nav-back-icon {
  width: 40rpx;
  height: 40rpx;
}

.nav-title {
  font-size: var(--font-lg);
  font-weight: 600;
  color: var(--color-text);
}

.nav-placeholder {
  width: 72rpx;
}

/* 一级 Tab 切换 */
.tab-bar {
  display: flex;
  align-items: center;
  background-color: #FFFFFF;
  padding: 0 30rpx;
  border-bottom: 1rpx solid var(--color-border-light);
}

.tab-item {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 24rpx 0;
  position: relative;
}

.tab-label {
  font-size: var(--font-base);
  color: var(--color-text-secondary);
}

.tab-item.active .tab-label {
  color: var(--color-primary);
  font-weight: 600;
}

.tab-item.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 48rpx;
  height: 4rpx;
  background-color: var(--color-primary);
  border-radius: 2rpx;
}

/* 二级 Tab 切换 */
.side-bar {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 40rpx;
  background-color: #FFFFFF;
  padding: 16rpx 30rpx;
  border-bottom: 1rpx solid var(--color-border-light);
}

.side-item {
  padding: 8rpx 32rpx;
  border-radius: 32rpx;
  background-color: var(--color-bg);
}

.side-item.active {
  background-color: var(--color-primary);
}

.side-label {
  font-size: var(--font-sm);
  color: var(--color-text-secondary);
}

.side-item.active .side-label {
  color: #FFFFFF;
  font-weight: 500;
}

/* 订单列表 */
.order-list {
  padding: 20rpx 24rpx;
}

.order-card {
  background-color: #FFFFFF;
  border-radius: var(--radius-md);
  padding: 24rpx;
  margin-bottom: 20rpx;
}

/* 用户信息 */
.order-user {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.user-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background-color: var(--color-border-light);
}

.user-name {
  flex: 1;
  font-size: var(--font-md);
  font-weight: 600;
  color: var(--color-text);
}

.side-tag {
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
  font-size: var(--font-xs);
}

.side-tag.buy {
  background-color: rgba(37, 90, 197, 0.1);
}

.side-tag.sell {
  background-color: rgba(20, 181, 84, 0.1);
}

.side-tag-text {
  font-size: var(--font-xs);
  font-weight: 500;
}

.side-tag.buy .side-tag-text {
  color: var(--color-primary);
}

.side-tag.sell .side-tag-text {
  color: #14B554;
}

/* 内容区域 */
.order-body {
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
  margin-bottom: 16rpx;
}

.order-content {
  flex: 1;
  font-size: var(--font-base);
  color: var(--color-text);
  line-height: 1.6;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.order-image {
  width: 120rpx;
  height: 120rpx;
  border-radius: var(--radius-sm);
  flex-shrink: 0;
  background-color: var(--color-border-light);
}

/* 备注提示 */
.order-remark {
  margin-bottom: 16rpx;
}

.remark-text {
  font-size: var(--font-xs);
  color: #FF9500;
}

/* 底部信息行 */
.order-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.type-label {
  font-size: var(--font-xs);
}

.price-wrap {
  display: flex;
  align-items: baseline;
  gap: 2rpx;
}

.price-label {
  font-size: var(--font-xs);
  color: var(--color-text-secondary);
}

.price-symbol {
  font-size: var(--font-xs);
  color: var(--color-text);
  font-weight: 600;
}

.price-value {
  font-size: var(--font-sm);
  color: var(--color-text);
  font-weight: 600;
}

.status-tag {
  padding: 6rpx 20rpx;
  border-radius: 20rpx;
}

.status-text {
  font-size: var(--font-xs);
  color: #FFFFFF;
  font-weight: 500;
}

/* 操作按钮组 */
.action-btn-group {
  margin-top: 16rpx;
  display: flex;
  gap: 16rpx;
}

.action-btn {
  flex: 1;
  height: 72rpx;
  line-height: 72rpx;
  text-align: center;
  font-size: var(--font-base);
  font-weight: 500;
  border-radius: var(--radius-md);
}

.action-btn-primary {
  background-color: var(--color-primary);
  color: #FFFFFF;
}

.action-btn-secondary {
  background-color: var(--color-bg);
  color: var(--color-text);
  border: 1rpx solid var(--color-border-light);
}

.action-btn-danger {
  background-color: #FF4D4F;
  color: #FFFFFF;
}

.action-btn:active {
  opacity: 0.85;
}

/* 确认收货按钮（保留兼容） */
.confirm-btn-wrap {
  margin-top: 16rpx;
}

.confirm-btn {
  width: 100%;
  height: 80rpx;
  line-height: 80rpx;
  background-color: #333333;
  color: #FFFFFF;
  font-size: var(--font-base);
  font-weight: 500;
  text-align: center;
  border-radius: var(--radius-md);
}

.confirm-btn:active {
  opacity: 0.85;
}

/* 空状态 */
.empty-state {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
}

.empty-text {
  font-size: var(--font-base);
  color: var(--color-text-secondary);
}
