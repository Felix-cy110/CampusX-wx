<!-- 聊天界面 -->
<view class="page {{keyboardHeight > 0 ? 'keyboard-open' : ''}}" style="height: calc(100vh - {{keyboardHeight}}px);">
  <!-- 页面加载出错时的兜底 -->
  <view wx:if="{{pageError}}" class="msg-empty-wrap">
    <text class="msg-empty-text">页面加载出错: {{errorMsg}}</text>
  </view>

  <block wx:else>
  <!-- 状态栏占位 -->
  <view class="status-bar-placeholder" style="height: {{statusBarHeight}}px;"></view>

  <!-- 自定义导航栏，与胶囊按钮平齐 -->
  <view class="nav-bar" style="height: {{navBarHeight}}px;">
    <view class="nav-back" bindtap="goBack">
      <image class="nav-back-icon" src="/images/SVG/返回.svg" mode="aspectFit"></image>
    </view>
    <view class="nav-center">
      <text class="nav-title">{{otherName}}</text>
    </view>
    <view class="nav-placeholder"></view>
  </view>

  <!-- 关注提示 -->
  <view class="follow-notice" wx:if="{{!isFollowed}}">
    <text class="follow-text">你尚未关注对方，对话仅限当前话题</text>
    <view class="follow-btn" bindtap="followUser">
      <text class="follow-btn-text">关注</text>
    </view>
  </view>

  <!-- 消息列表 -->
  <scroll-view class="msg-list" scroll-y scroll-with-animation scroll-into-view="{{scrollToView}}" enhanced show-scrollbar="{{false}}" bindtap="closePanel" bindscrolltoupper="onScrollToUpper" upper-threshold="100">
    <!-- 加载中 -->
    <view class="msg-empty-wrap" wx:if="{{loading}}">
      <text class="msg-loading-text">加载中...</text>
    </view>

    <!-- 加载失败 -->
    <view class="msg-empty-wrap" wx:elif="{{loadFailed}}">
      <text class="msg-empty-text">加载聊天记录失败</text>
      <text class="msg-empty-text" style="color: var(--color-primary); margin-top: 16rpx;" bindtap="loadHistory">点击重试</text>
    </view>

    <!-- 消息为空 -->
    <view class="msg-empty-wrap" wx:elif="{{messages.length === 0 && !loading}}">
      <text class="msg-empty-text">暂无消息，发送一条消息开始对话吧</text>
    </view>

    <!-- 消息列表 -->
    <block wx:else>
    <!-- 加载更多 -->
    <view class="load-more-wrap" wx:if="{{loadingMore}}">
      <text class="load-more-text">加载中...</text>
    </view>
    <view class="msg-container" wx:for="{{messages}}" wx:key="_id">

      <!-- 时间标记 -->
      <view class="time-tag" wx:if="{{item.showTime}}">
        <text class="time-tag-text">{{item.time}}</text>
      </view>

      <!-- 系统消息 -->
      <view wx:if="{{item.type === 'system'}}" class="system-msg">
        <view class="system-bubble">
          <text class="system-text">{{item.content}}</text>
        </view>
      </view>

      <!-- 对方消息：链接卡片 -->
      <view wx:elif="{{item.from === 'other' && item.type === 'link'}}" class="msg-row msg-left">
        <view class="msg-avatar-wrap">
          <image class="msg-avatar-img" src="{{otherAvatar}}" mode="aspectFill" bindtap="goToUserHome"></image>
        </view>
        <view class="msg-body">
          <view class="link-card" bindtap="openSharedPost" data-post-id="{{item.linkPostId}}">
            <image wx:if="{{item.linkCoverImage}}" class="link-cover" src="{{item.linkCoverImage}}" mode="aspectFill"></image>
            <text class="link-title">{{item.linkTitle}}</text>
            <text class="link-desc">{{item.linkDesc}}</text>
            <view class="link-footer">
              <text class="link-source">{{item.linkSharerName}} 分享的帖子</text>
            </view>
          </view>
        </view>
      </view>

      <!-- 对方消息：图片 -->
      <view wx:elif="{{item.from === 'other' && item.type === 'image'}}" class="msg-row msg-left">
        <view class="msg-avatar-wrap">
          <image class="msg-avatar-img" src="{{otherAvatar}}" mode="aspectFill" bindtap="goToUserHome"></image>
        </view>
        <view class="msg-body">
          <view class="bubble bubble-other bubble-image">
            <image class="msg-image" src="{{item.content}}" mode="widthFix" bindtap="previewImage" data-src="{{item.content}}"></image>
          </view>
          <text class="msg-time-tag" wx:if="{{item.time}}">{{item.time}}</text>
        </view>
      </view>

      <!-- 对方消息：文字 -->
      <view wx:elif="{{item.from === 'other'}}" class="msg-row msg-left">
        <view class="msg-avatar-wrap">
          <image class="msg-avatar-img" src="{{otherAvatar}}" mode="aspectFill" bindtap="goToUserHome"></image>
        </view>
        <view class="msg-body">
          <view class="bubble bubble-other">
            <text class="bubble-text">{{item.content}}</text>
          </view>
          <text class="msg-time-tag" wx:if="{{item.time}}">{{item.time}}</text>
        </view>
      </view>

      <!-- 我的消息：链接卡片 -->
      <view wx:elif="{{item.from === 'me' && item.type === 'link'}}" class="msg-row msg-right">
        <view class="msg-body msg-body-right">
          <view class="link-card link-card-me" bindtap="openSharedPost" data-post-id="{{item.linkPostId}}">
            <image wx:if="{{item.linkCoverImage}}" class="link-cover" src="{{item.linkCoverImage}}" mode="aspectFill"></image>
            <text class="link-title">{{item.linkTitle}}</text>
            <text class="link-desc">{{item.linkDesc}}</text>
            <view class="link-footer">
              <text class="link-source">你分享的帖子</text>
            </view>
          </view>
        </view>
        <view class="msg-avatar-wrap">
          <image class="msg-avatar-img" src="{{myAvatar}}" mode="aspectFill"></image>
        </view>
      </view>

      <!-- 我的消息：图片 -->
      <view wx:elif="{{item.from === 'me' && item.type === 'image'}}" class="msg-row msg-right">
        <view class="msg-body msg-body-right">
          <view class="bubble bubble-me bubble-image">
            <image class="msg-image" src="{{item.content}}" mode="widthFix" bindtap="previewImage" data-src="{{item.content}}"></image>
          </view>
          <text class="msg-time-tag msg-time-right" wx:if="{{item.time}}">{{item.time}}</text>
        </view>
        <view class="msg-avatar-wrap">
          <image class="msg-avatar-img" src="{{myAvatar}}" mode="aspectFill"></image>
        </view>
      </view>

      <!-- 我的消息：文字 -->
      <view wx:elif="{{item.from === 'me'}}" class="msg-row msg-right">
        <view class="msg-body msg-body-right">
          <view class="bubble bubble-me">
            <text class="bubble-text">{{item.content}}</text>
          </view>
          <text class="msg-time-tag msg-time-right" wx:if="{{item.time}}">{{item.time}}</text>
        </view>
        <view class="msg-avatar-wrap">
          <image class="msg-avatar-img" src="{{myAvatar}}" mode="aspectFill"></image>
        </view>
      </view>

    </view>
    </block>
    <view id="msg-bottom" style="height: 20rpx;"></view>
  </scroll-view>

  <!-- 底部区域（输入栏 + 弹窗） -->
  <view class="bottom-section safe-bottom">
    <view class="input-bar">
      <view class="input-wrapper">
        <input
          class="msg-input"
          placeholder="输入消息..."
          placeholder-class="input-placeholder"
          value="{{inputValue}}"
          bindinput="onInput"
          adjust-position="{{false}}"
          bindkeyboardheightchange="onChatKeyboardHeightChange"
          confirm-type="send"
          bindconfirm="sendMessage"
        />
      </view>
      <view class="plus-btn" bindtap="togglePanel">
        <image class="plus-icon" src="/images/SVG/新增.svg" mode="aspectFit"></image>
      </view>
      <view class="send-btn" bindtap="sendMessage">
        <text class="send-btn-text">发送</text>
      </view>
    </view>

    <!-- 底部弹出面板 -->
    <view class="action-panel {{showPanel ? 'panel-show' : ''}}">
      <view class="panel-content">
        <view class="action-item" bindtap="chooseImage">
          <view class="action-icon-wrap">
            <image class="action-icon" src="/images/SVG/相册.svg" mode="aspectFit"></image>
          </view>
          <text class="action-text">相册</text>
        </view>
        <view class="action-item" bindtap="takePhoto">
          <view class="action-icon-wrap">
            <image class="action-icon" src="/images/SVG/拍照.svg" mode="aspectFit"></image>
          </view>
          <text class="action-text">拍照</text>
        </view>
      </view>
    </view>
  </view>
  </block>
</view>
