.page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: var(--color-bg);
  position: relative;
}

/* ========== 固定头部 ========== */
.fixed-header {
  flex-shrink: 0;
  background: var(--color-bg-white);
  z-index: 100;
  position: relative;
}

.status-bar-placeholder {
  width: 100%;
}

.inbox-nav-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 24rpx;
  position: relative;
}

.inbox-title {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--color-text);
}

.nav-actions {
  display: flex;
  align-items: center;
  gap: 16rpx;
  /* 与个人资料页保持一致，避开微信右上角原生胶囊按钮 */
  margin-right: 180rpx;
}

.nav-btn {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: var(--color-bg);
  display: flex;
  align-items: center;
  justify-content: center;
  transition: transform 0.15s ease;
  flex-shrink: 0;
}

.nav-btn-hover {
  transform: scale(0.88);
  background: var(--color-border-light);
}

.nav-btn-text {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--color-text);
  letter-spacing: 4rpx;
  line-height: 1;
  margin-top: -2rpx;
}

.nav-icon-target {
  width: 28rpx;
  height: 28rpx;
  border-radius: 50%;
  border: 4rpx solid var(--color-text);
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
}

.nav-icon-target::after {
  content: '';
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: var(--color-text);
}

/* ========== 可滚动内容 ========== */
.page-content {
  flex: 1;
  height: 0;
  background: var(--color-bg);
}

/* ========== 通知分类栏 ========== */
.notify-bar {
  display: flex;
  background: var(--color-bg-white);
  padding: 24rpx 12rpx 32rpx;
  flex-shrink: 0;
  justify-content: space-around;
}

.notify-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  position: relative;
  padding: 8rpx 4rpx;
  border-radius: var(--radius-sm);
  transition: transform 0.15s ease;
  min-width: 0;
}

.notify-item-active {
  transform: scale(0.92);
  background: var(--color-bg);
}

.notify-icon-wrap {
  width: 96rpx;
  height: 96rpx;
  border-radius: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.08);
  transition: transform 0.2s ease, box-shadow 0.2s ease;
  position: relative;
  flex-shrink: 0;
}

.notify-item:active .notify-icon-wrap {
  transform: scale(0.9);
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.06);
}

.notify-icon-img {
  width: 44rpx;
  height: 44rpx;
  filter: brightness(10);
}

.notify-icon-emoji {
  font-size: 40rpx;
  line-height: 1;
}

.notify-label {
  font-size: 22rpx;
  color: var(--color-text);
  font-weight: 500;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  max-width: 100%;
  text-align: center;
}

.notify-badge {
  position: absolute;
  top: -6rpx;
  right: -6rpx;
  min-width: 32rpx;
  height: 32rpx;
  padding: 0 8rpx;
  background: var(--color-red);
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 600;
  box-shadow: 0 2rpx 6rpx rgba(255, 120, 120, 0.4);
  animation: badgePop 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
  z-index: 2;
}

.badge-text {
  font-size: 20rpx;
  color: #FFFFFF;
  line-height: 1;
}

@keyframes badgePop {
  0% { transform: scale(0); }
  60% { transform: scale(1.15); }
  100% { transform: scale(1); }
}

/* ========== 子 tab ========== */
.sub-tabs {
  display: flex;
  background: var(--color-bg-white);
  padding: 0 40rpx;
  flex-shrink: 0;
  gap: 48rpx;
  border-bottom: 1rpx solid var(--color-border-light);
  position: relative;
  z-index: 99;
}

.sub-tab-item {
  padding: 24rpx 0 20rpx;
  position: relative;
  cursor: pointer;
  transition: opacity 0.2s ease;
}

.sub-tab-item:active {
  opacity: 0.7;
}

.sub-tab-text {
  font-size: 30rpx;
  color: var(--color-text-secondary);
  transition: all 0.25s ease;
  white-space: nowrap;
  display: block;
}

.sub-tab-item.active .sub-tab-text {
  color: var(--color-primary);
  font-weight: 700;
  font-size: 32rpx;
}

.sub-tab-indicator {
  position: absolute;
  bottom: -1rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 28rpx;
  height: 4rpx;
  background: var(--color-primary);
  border-radius: 2rpx;
  animation: indicatorSlide 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}

@keyframes indicatorSlide {
  0% { width: 0; opacity: 0; }
  100% { width: 28rpx; opacity: 1; }
}

/* ========== 聊天列表 ========== */
.chat-list {
  background: var(--color-bg-white);
  overflow: hidden;
  padding-bottom: calc(120rpx + env(safe-area-inset-bottom));
}

/* ========== 滑动容器 ========== */
.swipe-container {
  position: relative;
  overflow: hidden;
}

.swipe-delete {
  position: absolute;
  right: 0;
  top: 0;
  bottom: 0;
  width: 180rpx;
  background: var(--color-red);
  display: flex;
  align-items: center;
  justify-content: center;
}

.swipe-delete-text {
  color: #FFFFFF;
  font-size: 28rpx;
  font-weight: 600;
}

.chat-item {
  display: flex;
  align-items: center;
  padding: 24rpx 30rpx;
  gap: 20rpx;
  position: relative;
  background: var(--color-bg-white);
  will-change: transform;
}

.chat-item:active {
  background: var(--color-bg);
}

.chat-item.swiping {
  z-index: 2;
}

/* 未读圆点 */
.unread-dot {
  position: absolute;
  left: 26rpx;
  top: 20rpx;
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: var(--color-primary);
  z-index: 1;
  border: 2rpx solid var(--color-bg-white);
}

.chat-avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  flex-shrink: 0;
  background: var(--color-bg);
  transition: transform 0.2s ease;
}

.chat-item:active .chat-avatar {
  transform: scale(0.95);
}

.chat-info {
  flex: 1;
  overflow: hidden;
  min-width: 0;
}

.chat-info-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.chat-name {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-text);
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.chat-time {
  font-size: 22rpx;
  color: var(--color-text-secondary);
  flex-shrink: 0;
  margin-left: 16rpx;
  white-space: nowrap;
}

.chat-bottom {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.chat-msg {
  font-size: 26rpx;
  color: var(--color-text-secondary);
  flex: 1;
  min-width: 0;
}

.chat-badge {
  min-width: 40rpx;
  height: 40rpx;
  padding: 0 10rpx;
  background: var(--color-red);
  color: #FFFFFF;
  font-size: 22rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 600;
  flex-shrink: 0;
  box-shadow: 0 2rpx 6rpx rgba(255, 120, 120, 0.3);
}

/* ========== 骨架屏 ========== */
.skeleton-list {
  background: var(--color-bg-white);
  margin-top: 16rpx;
  padding: 0 30rpx;
}

.skeleton-item {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 24rpx 0;
}

.skeleton-item + .skeleton-item {
  border-top: 1rpx solid var(--color-border-light);
}

.skeleton-avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: linear-gradient(90deg, var(--color-bg) 25%, var(--color-border-light) 50%, var(--color-bg) 75%);
  background-size: 200% 100%;
  animation: shimmer 1.5s infinite;
  flex-shrink: 0;
}

.skeleton-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.skeleton-line {
  height: 24rpx;
  border-radius: 12rpx;
  background: linear-gradient(90deg, var(--color-bg) 25%, var(--color-border-light) 50%, var(--color-bg) 75%);
  background-size: 200% 100%;
  animation: shimmer 1.5s infinite;
}

.skeleton-line-short {
  width: 40%;
}

.skeleton-line-long {
  width: 80%;
}

@keyframes shimmer {
  0% { background-position: 200% 0; }
  100% { background-position: -200% 0; }
}

/* ========== 空状态 ========== */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 160rpx 0;
}

.empty-icon-wrap {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: var(--color-bg);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 24rpx;
}

.empty-icon {
  width: 56rpx;
  height: 56rpx;
}

.empty-title {
  font-size: var(--font-lg);
  color: var(--color-text);
  font-weight: 600;
  margin-bottom: 12rpx;
}

.empty-desc {
  font-size: var(--font-sm);
  color: var(--color-text-secondary);
}

/* ========== 回到顶部 ========== */
.scroll-top-btn {
  position: fixed;
  right: 32rpx;
  bottom: 160rpx;
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: var(--color-bg-white);
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.12);
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 0;
  transform: translateY(40rpx);
  transition: all 0.3s ease;
  z-index: 100;
  pointer-events: none;
}

.scroll-top-btn.visible {
  opacity: 1;
  transform: translateY(0);
  pointer-events: auto;
}

.scroll-top-btn:active {
  transform: scale(0.9);
}

.scroll-top-arrow {
  font-size: 36rpx;
  color: var(--color-text-secondary);
  font-weight: 700;
}
