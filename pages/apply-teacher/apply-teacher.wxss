.page {
  min-height: 100vh;
  background: var(--color-bg);
  display: flex;
  flex-direction: column;
}

.fixed-header {
  background: var(--color-bg-white);
  flex-shrink: 0;
}

.status-bar-placeholder {
  width: 100%;
  background: var(--color-bg-white);
}

.nav-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 20rpx;
  background: var(--color-bg-white);
  border-bottom: 1rpx solid var(--color-border-light);
  box-sizing: border-box;
}

.nav-back {
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.nav-back-icon {
  width: 40rpx;
  height: 40rpx;
}

.nav-title {
  font-size: var(--font-lg);
  font-weight: 600;
  color: var(--color-text);
}

.nav-placeholder {
  width: 72rpx;
}

.form-scroll {
  flex: 1;
  background: var(--color-bg-white);
}

.form-card {
  overflow: hidden;
  background: var(--color-bg-white);
}

.section {
  background: var(--color-bg-white);
  padding: 28rpx;
  border-bottom: 1rpx solid var(--color-border-light);
}

.section-title {
  font-size: var(--font-md);
  font-weight: 600;
  color: var(--color-text);
  margin-bottom: 20rpx;
}

.required {
  color: var(--color-red);
  margin-left: 4rpx;
}

.input-wrap {
  background: var(--color-bg);
  border-radius: var(--radius-sm);
  overflow: hidden;
}

.form-input {
  width: 100%;
  height: 80rpx;
  padding: 0 20rpx;
  font-size: var(--font-base);
  color: var(--color-text);
  box-sizing: border-box;
}

.input-placeholder {
  color: var(--color-text-secondary);
  font-size: var(--font-base);
}

.submit-area {
  padding: 24rpx 28rpx 0;
}

.submit-btn {
  width: 100%;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--font-lg);
  font-weight: 600;
  border-radius: var(--radius-md);
}

.btn-disabled {
  opacity: 0.6;
  pointer-events: none;
}

.safe-bottom-spacer {
  height: calc(env(safe-area-inset-bottom) + 40rpx);
}
