/* 微信登录授权页 */
.page {
  min-height: 100vh;
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: var(--color-bg);
}

/* 蒙层 */
.overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.4);
  z-index: 1;
}

/* 授权弹窗 */
.auth-modal {
  position: relative;
  z-index: 2;
  width: 600rpx;
  background-color: var(--color-bg-white);
  border-radius: var(--radius-md);
  overflow: hidden;
  padding: 48rpx 40rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

/* 应用信息 */
.auth-header {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 40rpx;
}

.auth-app-icon {
  width: 100rpx;
  height: 100rpx;
  border-radius: var(--radius-md);
  background-color: var(--color-border-light);
  margin-bottom: 20rpx;
}

.auth-app-info {
  text-align: center;
}

.auth-app-name {
  font-size: var(--font-md);
  font-weight: 600;
  color: var(--color-text);
}

/* 授权标题 */
.auth-title {
  font-size: var(--font-md);
  font-weight: 600;
  color: var(--color-text);
  text-align: center;
  margin-bottom: 40rpx;
}

/* 手机号区域 */
.auth-phone-section {
  text-align: center;
  margin-bottom: 32rpx;
}

.auth-phone-label {
  font-size: var(--font-sm);
  color: var(--color-text-secondary);
  display: block;
  margin-bottom: 12rpx;
}

.auth-phone-number {
  font-size: var(--font-xl);
  font-weight: 700;
  color: var(--color-text);
}

/* 微信绑定说明 */
.auth-desc {
  margin-bottom: 48rpx;
}

.auth-desc-text {
  font-size: var(--font-xs);
  color: var(--color-text-secondary);
}

/* 按钮区域 */
.auth-buttons {
  width: 100%;
  display: flex;
  gap: 24rpx;
}

.auth-btn {
  flex: 1;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--radius-sm);
  font-size: var(--font-md);
  font-weight: 600;
}

.auth-btn-deny {
  background-color: var(--color-bg);
  color: var(--color-text);
}

.auth-btn-allow {
  background-color: var(--color-wechat-green);
  color: #FFFFFF;
}

/* 使用其他手机号 */
.auth-other {
  margin-top: 32rpx;
  text-align: center;
}

.auth-other-text {
  font-size: var(--font-sm);
  color: var(--color-dark-blue);
}
