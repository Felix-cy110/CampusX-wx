<!-- 完善信息页 -->
<view class="page">
  <!-- 状态栏占位 -->
  <view style="height: {{statusBarHeight}}px; background: var(--color-bg-white);"></view>

  <!-- 导航栏 -->
  <view class="nav-bar" style="height: {{navBarHeight}}px;">
    <view class="nav-back" bindtap="goBack">
      <image class="nav-back-img" src="/images/SVG/返回.svg" mode="aspectFit"></image>
    </view>
    <text class="nav-title">完善信息</text>
    <view class="nav-placeholder"></view>
  </view>

  <view class="wechat-profile-tip">
    <text class="wechat-profile-tip-title">使用微信资料</text>
    <text class="wechat-profile-tip-text">点击头像可选择微信头像；点击昵称输入框可使用微信昵称</text>
  </view>

  <!-- 头像 -->
  <view class="form-section">
    <button class="form-item avatar-item avatar-button" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar">
      <text class="form-label">头像</text>
      <view class="form-right">
        <image class="avatar-preview" src="{{avatar || '/images/avatars/default.png'}}" mode="aspectFill"></image>
        <text class="avatar-action">{{avatarUploading ? '上传中' : (avatarUrl ? '更换' : '使用微信头像')}}</text>
        <text class="form-arrow">›</text>
      </view>
    </button>

    <!-- 昵称 -->
    <view class="form-item">
      <text class="form-label">昵称</text>
      <view class="form-right">
        <input class="form-input" type="nickname" placeholder="点击使用微信昵称" value="{{nickname}}" bindinput="onNicknameInput" />
      </view>
    </view>

    <!-- 入学时间 -->
    <picker mode="selector" range="{{enrollmentYears}}" value="{{enrollmentYearIndex}}" bindchange="onEnrollmentYearChange">
      <view class="form-item picker-item">
        <text class="form-label">入学时间</text>
        <view class="form-right">
          <text class="form-value {{enrollmentYear ? '' : 'form-placeholder'}}">{{enrollmentYear ? enrollmentYear + '年' : '请选择'}}</text>
          <text class="form-arrow">›</text>
        </view>
      </view>
    </picker>

    <!-- 选择高校 -->
    <view class="form-item" bindtap="selectSchool">
      <text class="form-label">选择高校</text>
      <view class="form-right">
        <text class="form-value {{schoolName ? '' : 'form-placeholder'}}">{{schoolName || '请选择高校'}}</text>
        <text class="form-arrow">›</text>
      </view>
    </view>

    <!-- 选择专业 -->
    <view class="form-item" bindtap="selectMajor">
      <text class="form-label">选择专业</text>
      <view class="form-right">
        <text class="form-value {{majorName ? '' : 'form-placeholder'}}">{{majorName || '请选择专业'}}</text>
        <text class="form-arrow">›</text>
      </view>
    </view>

    <!-- 手机号 -->
    <view class="form-item">
      <text class="form-label">手机号</text>
      <view class="form-right">
        <input class="form-input" type="number" placeholder="请输入手机号" value="{{phone}}" bindinput="onPhoneInput" />
      </view>
    </view>
  </view>

  <!-- 进入按钮 -->
  <view class="btn-area">
    <view class="btn btn-primary {{canSubmit ? '' : 'btn-incomplete'}}" bindtap="submit">进入</view>
  </view>
</view>
