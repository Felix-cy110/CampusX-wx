.page {
  height: 100vh;
  overflow: hidden;
  background: var(--color-bg);
  display: flex;
  flex-direction: column;
}

.fixed-header {
  background: var(--color-bg-white);
  flex-shrink: 0;
}

.status-bar-placeholder {
  width: 100%;
  background: var(--color-bg-white);
}

/* 导航栏 */
.nav-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 20rpx;
  background: var(--color-bg-white);
  border-bottom: 1rpx solid var(--color-border-light);
  box-sizing: border-box;
}

.nav-back {
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.nav-back-icon {
  width: 40rpx;
  height: 40rpx;
}

.nav-title {
  font-size: var(--font-lg);
  font-weight: 600;
  color: var(--color-text);
}

.nav-placeholder {
  width: 72rpx;
}

/* 提示条 */
.notice-bar {
  margin: 16rpx 30rpx 0;
  padding: 16rpx 24rpx;
  background: rgba(37, 90, 197, 0.06);
  border-radius: var(--radius-sm);
  display: flex;
  align-items: center;
}

.notice-text {
  font-size: var(--font-sm);
  color: var(--color-primary);
  line-height: 1.5;
}

/* Tab 切换 */
.tab-bar {
  display: flex;
  background: var(--color-bg-white);
  padding: 0 30rpx;
  flex-shrink: 0;
  position: relative;
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 28rpx 0;
  font-size: var(--font-md);
  color: var(--color-text-secondary);
  position: relative;
}

.tab-item.active {
  color: var(--color-primary);
  font-weight: 600;
}

.tab-indicator {
  position: absolute;
  bottom: 0;
  left: 0;
  transform: translateX(-50%);
  width: 56rpx;
  height: 6rpx;
  background: var(--color-primary);
  border-radius: 3rpx;
  transition: left 0.35s cubic-bezier(0.32, 0.72, 0, 1);
}

/* 表单滚动区 */
.form-scroll {
  flex: 1;
  height: 0;
  background: var(--color-bg-white);
}

/* 表单卡片容器 */
.form-card {
  overflow: hidden;
  background: var(--color-bg-white);
  padding-bottom: 40rpx;
}

/* 表单区域 */
.section {
  background: var(--color-bg-white);
  padding: 0 28rpx;
  border-bottom: none;
}

.section-title {
  font-size: var(--font-md);
  font-weight: 600;
  color: var(--color-text);
  margin-bottom: 20rpx;
}

.required {
  color: var(--color-red);
  margin-left: 4rpx;
}

.optional-tag {
  font-size: var(--font-xs);
  color: var(--color-text-secondary);
  font-weight: 400;
  margin-left: 10rpx;
}

/* 分组标签 */
.group-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.group-tag {
  padding: 14rpx 28rpx;
  border-radius: 32rpx;
  font-size: var(--font-sm);
  color: var(--color-text-secondary);
  background: var(--color-bg);
  border: 1rpx solid var(--color-border-light);
  transition: all 0.2s;
}

.group-tag.active {
  color: var(--color-primary);
  background: rgba(37, 90, 197, 0.08);
  border-color: var(--color-primary);
}

/* 输入框 */
.input-wrap {
  overflow: hidden;
}

.form-input {
  width: 100%;
  height: 80rpx;
  padding: 0;
  font-size: var(--font-base);
  color: var(--color-text);
  box-sizing: border-box;
}

.textarea-wrap {
  overflow: hidden;
  padding: 0;
}

.form-textarea {
  width: 100%;
  min-height: 160rpx;
  font-size: var(--font-base);
  color: var(--color-text);
}

.input-placeholder {
  color: var(--color-text-secondary);
  font-size: var(--font-base);
}

.char-count {
  text-align: right;
  font-size: var(--font-xs);
  color: var(--color-text-secondary);
  margin-top: 4rpx;
}

/* 内容快捷输入 */
.content-actions {
  display: flex;
  justify-content: flex-end;
  margin-top: 12rpx;
}

.quick-fill-btn {
  padding: 8rpx 24rpx;
  border-radius: 32rpx;
  font-size: var(--font-sm);
  color: var(--color-primary);
  background: rgba(37, 90, 197, 0.08);
  border: 1rpx solid var(--color-primary);
  transition: all 0.2s;
}

.quick-fill-btn.active {
  color: #FFFFFF;
  background: var(--color-primary);
}

/* 图片选择 */
.image-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.image-item {
  position: relative;
  width: 200rpx;
  height: 200rpx;
  border-radius: var(--radius-sm);
  overflow: hidden;
}

.uploaded-img {
  width: 100%;
  height: 100%;
}

.img-remove {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  width: 40rpx;
  height: 40rpx;
  background: rgba(0, 0, 0, 0.5);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.img-remove-icon {
  color: #FFFFFF;
  font-size: 28rpx;
  transform: rotate(45deg);
  line-height: 1;
}

.image-add {
  width: 200rpx;
  height: 200rpx;
  border-radius: var(--radius-sm);
  border: 2rpx dashed var(--color-border);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: var(--color-bg);
  gap: 8rpx;
}

.add-icon {
  font-size: 48rpx;
  color: var(--color-text-secondary);
  line-height: 1;
}

.add-text {
  font-size: var(--font-xs);
  color: var(--color-text-secondary);
}

/* Toggle 开关 */
.toggle-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.toggle-label {
  font-size: var(--font-base);
  color: var(--color-text);
}

.toggle-desc {
  font-size: var(--font-xs);
  color: var(--color-text-secondary);
  margin-top: 12rpx;
  display: block;
}

.toggle-switch {
  width: 88rpx;
  height: 48rpx;
  border-radius: 24rpx;
  background: var(--color-border-light);
  position: relative;
  transition: background 0.3s;
  flex-shrink: 0;
}

.toggle-switch.on {
  background: var(--color-primary);
}

.toggle-knob {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: #FFFFFF;
  position: absolute;
  top: 4rpx;
  left: 4rpx;
  transition: left 0.3s;
  box-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.15);
}

.toggle-switch.on .toggle-knob {
  left: 44rpx;
}

/* 选择器行 */
.picker-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 0;
  font-size: var(--font-base);
  color: var(--color-text);
}

.picker-placeholder {
  color: var(--color-text-secondary);
}

.picker-arrow {
  color: var(--color-text-secondary);
  font-size: var(--font-md);
}

/* 售价 */
.price-row {
  display: flex;
  align-items: center;
}

.price-symbol {
  font-size: var(--font-base);
  color: var(--color-text);
  font-weight: 600;
  margin-right: 8rpx;
}

.price-input-wrap {
  flex: 1;
  background: var(--color-bg);
  border-radius: var(--radius-sm);
  overflow: hidden;
}

.price-input {
  width: 100%;
  height: 72rpx;
  padding: 0 20rpx;
  font-size: var(--font-base);
  color: var(--color-text);
  text-align: center;
  box-sizing: border-box;
}

.price-unit {
  margin-left: 12rpx;
  font-size: var(--font-base);
  color: var(--color-text);
  flex-shrink: 0;
}

/* 费用提示 */
.fee-notice {
  margin: 0;
  padding: 20rpx 28rpx;
  background: rgba(255, 195, 0, 0.06);
  border-top: 1rpx solid var(--color-border-light);
  border-bottom: 1rpx solid var(--color-border-light);
}

.fee-text {
  font-size: var(--font-xs);
  color: var(--color-text-secondary);
  line-height: 1.5;
}

/* ===== 付费选项 ===== */
.payment-option {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 0;
}

.payment-info {
  flex: 1;
}

.payment-label {
  font-size: var(--font-base);
  color: var(--color-text);
  font-weight: 500;
}

.payment-desc {
  font-size: var(--font-xs);
  color: var(--color-text-secondary);
  margin-top: 6rpx;
  display: block;
}

.payment-right {
  display: flex;
  align-items: center;
  gap: 16rpx;
  flex-shrink: 0;
}

.payment-amount {
  flex-shrink: 0;
}

.amount-value {
  font-size: var(--font-base);
  color: var(--color-green);
  font-weight: 600;
}

.amount-value.paid {
  color: var(--color-red);
}

.amount-value.mini {
  font-size: var(--font-sm);
  color: var(--color-orange);
  font-weight: 500;
}

.loading-text {
  color: var(--color-text-secondary);
  font-style: italic;
}

/* 提交按钮 */
.submit-area {
  padding: 24rpx 28rpx 0;
}

.submit-btn {
  width: 100%;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--font-lg);
  font-weight: 600;
  border-radius: var(--radius-md);
}

.safe-bottom-spacer {
  height: calc(env(safe-area-inset-bottom) + 40rpx);
}