<!-- 选择学校页 -->
<view class="page">
  <!-- 状态栏占位 -->
  <view class="status-bar-placeholder" style="height: {{statusBarHeight}}px;"></view>

  <!-- 导航栏：与胶囊按钮平齐 -->
  <view class="nav-bar" style="height: {{navBarHeight}}px;">
    <view class="nav-back" bindtap="goBack">
      <image class="nav-back-icon" src="/images/SVG/返回.svg" mode="aspectFit"></image>
    </view>
    <text class="nav-title">选择学校</text>
    <view class="nav-placeholder"></view>
  </view>

  <!-- 搜索栏 -->
  <view class="search-bar">
    <view class="search-wrapper">
      <image class="search-icon" src="/images/SVG/搜索.svg" mode="aspectFit"></image>
      <input class="search-input" placeholder="搜索..." value="{{searchText}}" bindinput="onSearch" />
      <text class="search-clear" wx:if="{{searchText}}" bindtap="clearSearch">✕</text>
    </view>
  </view>

  <!-- 学校列表 -->
  <scroll-view class="school-list" scroll-y>
    <view
      class="school-item"
      wx:for="{{filteredSchools}}"
      wx:key="id"
      bindtap="selectSchool"
      data-id="{{item.id}}"
      data-name="{{item.name}}"
    >
      <view class="school-info">
        <text class="school-name">{{item.name}}</text>
        <view class="school-stats" wx:if="{{item.province || item.city}}">
          <text class="school-stat-item">{{item.province}}{{item.city}}</text>
        </view>
      </view>
      <view class="school-right">
        <text class="school-arrow">›</text>
      </view>
    </view>

    <!-- 空状态 -->
    <view class="empty-state" wx:if="{{filteredSchools.length === 0}}">
      <text>没有找到相关学校</text>
    </view>
  </scroll-view>
</view>
