@import '/app.wxss';

.page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background-color: var(--color-bg);
}

.fixed-header {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
  background-color: #fff;
}

.nav-bar {
  display: flex;
  align-items: center;
  padding: 0 28rpx;
}

.nav-back {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.nav-back-icon {
  width: 36rpx;
  height: 36rpx;
}

.nav-title {
  flex: 1;
  text-align: center;
  font-size: var(--font-xl);
  font-weight: 600;
  color: var(--color-text);
}

.nav-placeholder {
  width: 48rpx;
}

.page-scroll {
  flex: 1;
  margin-top: calc(var(--status-bar-height, 48rpx) + 88rpx);
}

/* ===== 教师+课程信息卡片 ===== */
.info-header {
  background-color: #fff;
  padding: 32rpx;
  margin-bottom: 16rpx;
}

.info-teacher-row {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}

.info-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, var(--color-primary), #6ea8fe);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.info-avatar-text {
  font-size: 34rpx;
  font-weight: 600;
  color: #fff;
}

.info-main {
  display: flex;
  flex-direction: column;
  margin-left: 20rpx;
  min-width: 0;
}

.info-teacher-name {
  font-size: var(--font-lg);
  font-weight: 600;
  color: var(--color-text);
}

.info-course-name {
  font-size: var(--font-sm);
  color: var(--color-primary);
  margin-top: 6rpx;
  font-weight: 500;
}

.info-stats {
  display: flex;
  align-items: center;
  justify-content: center;
}

.info-stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 0 40rpx;
}

.info-stat-value {
  font-size: var(--font-3xl);
  font-weight: 700;
  color: var(--color-primary);
}

.info-stat-label {
  font-size: var(--font-xs);
  color: var(--color-text-secondary);
  margin-top: 4rpx;
}

.info-stat-divider {
  width: 2rpx;
  height: 48rpx;
  background-color: var(--color-border);
}

/* ===== 评价列表标题 ===== */
.section-title {
  padding: 24rpx 32rpx 12rpx;
  font-size: var(--font-md);
  font-weight: 600;
  color: var(--color-text);
}

/* ===== 评价列表 ===== */
.rating-list {
  /* 无左右内边距，卡片撑满宽度 */
}

.rating-card {
  background-color: #fff;
  padding: 24rpx 32rpx;
  border-bottom: 1rpx solid var(--color-border-light);
}

.rating-card-header {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}

.rating-user-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.rating-user-info {
  flex: 1;
  margin-left: 16rpx;
  min-width: 0;
}

.rating-user-name {
  font-size: var(--font-sm);
  font-weight: 600;
  color: var(--color-text);
  display: block;
}

.rating-star-row {
  display: flex;
  align-items: center;
  margin-top: 4rpx;
}

.rating-star {
  font-size: 22rpx;
  color: #e0e0e0;
  margin-right: 2rpx;
}

.rating-star.active {
  color: var(--color-star, #f5a623);
}

.rating-score-num {
  font-size: var(--font-sm);
  font-weight: 700;
  color: var(--color-star, #f5a623);
  margin-left: 8rpx;
}

.rating-time {
  font-size: var(--font-xs);
  color: var(--color-text-secondary);
  flex-shrink: 0;
  align-self: flex-start;
  margin-top: 4rpx;
}

.rating-content {
  font-size: var(--font-sm);
  color: var(--color-text);
  line-height: 1.7;
  display: block;
  margin-bottom: 12rpx;
}

/* 评价标签 */
.rating-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 4rpx;
}

.rating-tag {
  display: inline-block;
  padding: 6rpx 14rpx;
  border-radius: 6rpx;
  font-size: 20rpx;
  color: var(--color-primary);
  background-color: rgba(37, 90, 197, 0.08);
}

/* ===== 加载 & 空状态 ===== */
.load-more-tip {
  text-align: center;
  padding: 24rpx;
  font-size: var(--font-xs);
  color: var(--color-text-secondary);
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 0;
  font-size: var(--font-sm);
  color: var(--color-text-secondary);
}

.empty-action {
  margin-top: 24rpx;
}

.empty-action-text {
  font-size: var(--font-sm);
  color: var(--color-primary);
  font-weight: 500;
}

/* ===== 底部安全距离 ===== */
.safe-bottom-spacer {
  height: 160rpx;
}

/* ===== 浮动按钮（复刻 tabBar 中间发布按钮） ===== */
.fab-btn {
  position: fixed;
  right: 32rpx;
  bottom: 160rpx;
  width: 105rpx;
  height: 105rpx;
  border-radius: 50%;
  background-color: #255AC5;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(37, 90, 197, 0.4);
  z-index: 99;
}

.fab-btn:active {
  opacity: 0.85;
  transform: scale(0.95);
}

.fab-inner {
  width: 36rpx;
  height: 36rpx;
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
}

.fab-line {
  position: absolute;
  background-color: #FFFFFF;
  border-radius: 3rpx;
}

.fab-line-h {
  width: 36rpx;
  height: 6rpx;
}

.fab-line-v {
  width: 6rpx;
  height: 36rpx;
}
