.page {
  min-height: 100vh;
  background: var(--color-bg);
}

.nav-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 24rpx;
  background: #fff;
}

.nav-back {
  width: 44rpx;
  height: 44rpx;
}

.nav-title {
  font-size: var(--font-lg);
  font-weight: 600;
  color: var(--color-text);
}

.container {
  padding: 0;
}

/* 表单区域 */
.form-section {
  background: var(--color-bg-white);
  border-radius: 0;
  padding: 8rpx 30rpx;
  margin-bottom: 16rpx;
}

.form-item {
  padding: 20rpx 0;
}

.form-item-border {
  border-top: 1rpx solid var(--color-border-light);
}

.form-label {
  font-size: var(--font-md);
  font-weight: 600;
  color: var(--color-text);
  display: block;
  margin-bottom: 16rpx;
}

.required {
  color: var(--color-red);
  margin-left: 4rpx;
}

.input-wrap {
  background: var(--color-bg);
  border-radius: var(--radius-sm);
  overflow: hidden;
}

.form-input {
  width: 100%;
  height: 80rpx;
  padding: 0 20rpx;
  font-size: var(--font-base);
  color: var(--color-text);
  box-sizing: border-box;
}

.input-placeholder {
  color: var(--color-text-secondary);
}

/* 默认地址开关行 */
.form-item-switch {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.form-item-switch .form-label {
  margin-bottom: 0;
}

/* 提交按钮 */
.submit-area {
  margin-top: 40rpx;
  padding: 0 30rpx;
}

.submit-btn {
  width: 100%;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--font-lg);
  font-weight: 600;
  border-radius: var(--radius-md);
}
