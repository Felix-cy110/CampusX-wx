/* 我的集市帖子 */
.page {
  min-height: 100vh;
  background-color: var(--color-bg);
  padding-bottom: 40rpx;
}

.content-list {
  padding: 16rpx 30rpx;
}

.post-card {
  background-color: var(--color-bg-white);
  border-radius: var(--radius-md);
  padding: 24rpx;
  margin-bottom: 16rpx;
}

/* 帖子头部 */
.post-header {
  display: flex;
  align-items: flex-start;
}

.post-avatar {
  width: 42rpx;
  height: 42rpx;
  border-radius: 50%;
  flex-shrink: 0;
  background: #CCCCCC;
}

.post-user-info {
  flex: 1;
  margin-left: 16rpx;
}

.post-user-row {
  display: flex;
  align-items: center;
}

.post-user-name {
  font-size: var(--font-sm);
  color: var(--color-text);
  font-weight: 500;
}

.post-type-tag {
  font-size: var(--font-xs);
  color: var(--color-primary);
  background: rgba(37, 90, 197, 0.08);
  padding: 2rpx 12rpx;
  border-radius: 4rpx;
  margin-left: 10rpx;
}

.post-time {
  font-size: var(--font-xs);
  color: var(--color-text-secondary);
  display: block;
  margin-top: 4rpx;
}

.post-more {
  padding: 4rpx 16rpx;
  flex-shrink: 0;
}

.delete-text {
  font-size: var(--font-sm);
  color: var(--color-red);
}

/* 标题 */
.post-title {
  font-size: var(--font-md);
  color: var(--color-text);
  font-weight: 700;
  display: block;
  margin-top: 16rpx;
}

/* 内容 */
.post-content-text {
  font-size: var(--font-sm);
  color: var(--color-text-secondary);
  line-height: 1.6;
  margin-top: 10rpx;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

/* 图片 */
.post-images {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 16rpx;
}

.post-image {
  width: 160rpx;
  height: 160rpx;
  border-radius: var(--radius-sm);
  background: var(--color-bg);
}

/* 底部 */
.post-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 20rpx;
}

.post-price {
  display: flex;
  align-items: baseline;
}

.price-current {
  font-size: var(--font-md);
  font-weight: 700;
  color: var(--color-red);
}

.price-original {
  font-size: var(--font-xs);
  color: var(--color-text-secondary);
  text-decoration: line-through;
  margin-left: 10rpx;
}

.post-stats {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.post-stat-item {
  display: flex;
  align-items: center;
}

.stat-icon {
  font-size: var(--font-xs);
  margin-right: 4rpx;
}

.stat-num {
  font-size: var(--font-xs);
  color: var(--color-text-secondary);
}

/* 状态标签行 */
.post-status-row {
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid var(--color-border-light);
}

.item-status-tag {
  display: inline-block;
  padding: 4rpx 16rpx;
  border-radius: var(--radius-sm);
  font-size: var(--font-xs);
  font-weight: 500;
}

.status-available {
  color: var(--color-green);
  background: rgba(20, 181, 84, 0.1);
}

.status-taken {
  color: var(--color-text-secondary);
  background: var(--color-bg);
}

/* 底部安全区 */
.bottom-safe {
  height: calc(20rpx + constant(safe-area-inset-bottom));
  height: calc(20rpx + env(safe-area-inset-bottom));
}
