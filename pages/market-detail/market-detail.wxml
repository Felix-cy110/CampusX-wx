<!-- 集市商品详情页 - 对接后端 API -->
<view class="page">
  <view class="fixed-header">
    <view class="status-bar-placeholder" style="height: {{statusBarHeight}}px;"></view>
    <view class="detail-nav-bar" style="height: {{navBarHeight}}px;">
      <view class="nav-back" bindtap="goBack">
        <image class="nav-back-icon" src="/images/SVG/返回.svg" mode="aspectFit"></image>
      </view>
      <text class="detail-title">商品详情</text>
      <view class="nav-more" bindtap="showMoreOptions">
        <text class="nav-more-icon">⋮</text>
      </view>
    </view>
  </view>
  <scroll-view class="content" scroll-y wx:if="{{!loading}}">
    <!-- 用户信息行：头像 + 用户名 + 时间 + 关注按钮 -->
    <view class="user-info-row">
      <view class="user-info-left" bindtap="goToUserProfile" data-uid="{{item.user.uid}}" data-name="{{item.user.name}}" data-avatar="{{item.user.avatar}}">
        <image class="user-info-avatar" src="{{item.user.avatar}}" mode="aspectFill"></image>
        <view class="user-info-info">
          <text class="user-info-name">{{item.user.name}}</text>
          <text class="user-info-time">{{item.time}}</text>
        </view>
      </view>
      <view class="user-info-right">
        <view class="follow-btn" wx:if="{{!isFollowed && !item.isOwn}}" bindtap="toggleFollow">
          <text>+关注</text>
        </view>
        <view class="follow-btn followed" wx:if="{{isFollowed && !item.isOwn}}" bindtap="toggleFollow">
          <text>已关注</text>
        </view>
      </view>
    </view>

    <!-- 商品标题 -->
    <text class="post-title">{{item.title}}</text>

    <!-- 商品描述 -->
    <text class="post-body">{{item.content}}</text>

    <!-- 图片区 -->
    <view class="post-images" wx:if="{{item.images && item.images.length}}">
      <image class="post-image" wx:for="{{item.images}}" wx:key="*this" src="{{item}}" mode="aspectFill"></image>
    </view>

    <!-- 商品信息 -->
    <view class="info-row">
      <text class="info-label">新旧程度：</text>
      <text class="info-value">{{item.condition}}</text>
    </view>
    <view class="info-row" wx:if="{{item.deliveryType}}">
      <text class="info-label">交货方式：</text>
      <text class="info-value">{{item.deliveryType}}</text>
    </view>
    <view class="info-row" wx:if="{{item.hasNotes}}">
      <text class="info-label">笔记情况：</text>
      <text class="info-value">{{item.hasNotes}}</text>
    </view>
    <view class="info-row" wx:if="{{item.author}}">
      <text class="info-label">作者/出版社：</text>
      <text class="info-value">{{item.author}} / {{item.publisher}}（{{item.edition}}版）</text>
    </view>

    <!-- 书库收录课程（仅二手书有） -->
    <view class="info-row" wx:if="{{item.courses && item.courses.length > 0}}">
      <text class="info-label">相关课程：</text>
      <view class="course-list">
        <text class="course-item" wx:for="{{item.courses}}" wx:key="courseId">
          {{item.courseName}}（{{item.majorName}} {{item.grade}}年级 {{item.semester === 1 ? '上学期' : '下学期'}}）
        </text>
      </view>
    </view>

    <!-- 价格信息 -->
    <view class="info-row">
      <text class="info-label">价格：</text>
      <text class="info-value price-value">¥{{item.price}}</text>
    </view>

  </scroll-view>

  <!-- 加载中 -->
  <view class="empty-state" wx:if="{{loading}}">
    <text>加载中...</text>
  </view>

  <!-- 底部操作栏 -->
  <view class="bottom-bar">
    <view class="bottom-action favorite-action" bindtap="toggleFavorite">
      <text class="bottom-action-icon">{{isFavorited ? '⭐' : '☆'}}</text>
      <text class="bottom-action-count" style="color: {{isFavorited ? 'var(--color-star)' : 'var(--color-text-secondary)'}};">{{isFavorited ? '已收藏' : '收藏'}}</text>
    </view>
    <button class="bottom-action favorite-action share-native-button" open-type="share">
      <image class="share-action-icon" src="/images/SVG/转发.svg" mode="aspectFit"></image>
      <text class="bottom-action-count">分享</text>
    </button>
    <!-- 占位：将右侧按钮推到末端 -->
    <view class="bottom-spacer"></view>
    <block wx:if="{{!item.isOwn}}">
      <view class="bottom-btn btn-contact" bindtap="contactSeller">
        <text>联系卖家</text>
      </view>
      <view class="bottom-btn btn-buy" bindtap="createOrder">
        <text>立即购买</text>
      </view>
    </block>
    <block wx:if="{{item.isOwn && !isOwnerClosing}}">
      <view class="bottom-btn btn-off-shelf" bindtap="closeDeal">
        <text>下架商品</text>
      </view>
    </block>
    <block wx:if="{{item.isOwn && isOwnerClosing}}">
      <view class="bottom-btn btn-off-shelf disabled">
        <text>已下架</text>
      </view>
    </block>
  </view>
</view>
