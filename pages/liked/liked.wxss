.page {
  min-height: 100vh;
  background: var(--color-bg);
  padding-bottom: 40rpx;
}

.status-bar-placeholder {
  background: var(--color-bg-white);
}

.nav-bar {
  display: flex;
  align-items: center;
  background: var(--color-bg-white);
  padding: 0 24rpx;
  border-bottom: 1rpx solid var(--color-border-light);
}

.nav-back {
  width: 44rpx;
  height: 44rpx;
  flex-shrink: 0;
  transition: transform 0.15s ease;
}

.nav-back:active {
  transform: scale(0.9);
}

.nav-title {
  flex: 1;
  text-align: center;
  font-size: var(--font-lg);
  font-weight: 600;
  color: var(--color-text);
}

.nav-placeholder {
  width: 44rpx;
  flex-shrink: 0;
}

.user-list {
  background: transparent;
}

.user-list-inner {
  background: var(--color-bg-white);
  border-radius: var(--radius-md);
  padding: 0 30rpx;
  overflow: hidden;
}

.user-item {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  transition: background 0.15s ease;
}

.user-item .flex-1 {
  min-width: 0;
  overflow: hidden;
}

.user-item + .user-item {
  border-top: 1rpx solid var(--color-border-light);
}

.user-item-hover {
  background: var(--color-bg);
}

.user-info-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-bottom: 6rpx;
}

.user-name {
  font-size: var(--font-base);
  color: var(--color-text);
  font-weight: 600;
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.user-desc {
  font-size: var(--font-xs);
  color: var(--color-text-secondary);
  white-space: nowrap;
}

.user-time {
  font-size: var(--font-xs);
  color: var(--color-text-secondary);
  margin-left: auto;
  flex-shrink: 0;
  white-space: nowrap;
}

.liked-ref {
  font-size: var(--font-xs);
  color: var(--color-text-secondary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  max-width: 100%;
}

.loading-tip {
  text-align: center;
  padding: 24rpx 0;
  font-size: var(--font-sm);
  color: var(--color-text-secondary);
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 200rpx 0;
}

.empty-icon-wrap {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: var(--color-bg);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 24rpx;
}

.empty-icon {
  font-size: 56rpx;
  line-height: 1;
}

.empty-title {
  font-size: var(--font-lg);
  color: var(--color-text);
  font-weight: 600;
  margin-bottom: 12rpx;
}

.empty-desc {
  font-size: var(--font-sm);
  color: var(--color-text-secondary);
}
