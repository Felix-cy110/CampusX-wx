<!-- 关注与粉丝 -->
<view class="page">
  <view class="status-bar-placeholder" style="height: {{statusBarHeight}}px;"></view>
  <view class="nav-bar" style="height: {{navBarHeight}}px;">
    <image class="nav-back" src="/images/SVG/返回.svg" mode="aspectFit" bindtap="navigateBack"></image>
    <text class="nav-title">关注与粉丝</text>
    <view class="nav-placeholder"></view>
  </view>

  <!-- Tab 切换栏 -->
  <view class="tab-bar">
    <view class="tab-item {{currentTab === 'following' ? 'active' : ''}}" bindtap="switchTab" data-tab="following">
      <text>关注</text>
    </view>
    <view class="tab-item {{currentTab === 'follower' ? 'active' : ''}}" bindtap="switchTab" data-tab="follower">
      <text>粉丝</text>
    </view>
    <view class="tab-indicator {{currentTab === 'follower' ? 'right' : ''}}"></view>
  </view>

  <!-- 关注列表 -->
  <view class="list-wrapper" wx:if="{{currentTab === 'following'}}">
    <scroll-view class="user-list" wx:if="{{followingList.length > 0}}" scroll-y enhanced show-scrollbar="{{false}}" bindscrolltolower="onFollowingScrollToLower" lower-threshold="100">
      <view class="user-item" wx:for="{{followingList}}" wx:key="uid">
        <image class="user-avatar" src="{{item.avatar}}" mode="aspectFill" catchtap="goToUserProfile" data-uid="{{item.uid}}" data-name="{{item.name}}" data-avatar="{{item.avatar}}"></image>
        <text class="user-name flex-1 ml-20 ellipsis">{{item.name}}</text>
        <view class="follow-btn {{item.isFollowed ? 'followed' : ''}}" catchtap="toggleFollow" data-index="{{index}}">
          <text>{{item.isFollowed ? '已关注' : '关注'}}</text>
        </view>
      </view>

      <view class="loading-tip" wx:if="{{followingLoading}}">
        <text>加载中...</text>
      </view>

      <view class="loading-tip" wx:if="{{!followingHasMore && followingList.length > 0}}">
        <text>没有更多了</text>
      </view>
    </scroll-view>
    <view class="empty-state" wx:if="{{followingList.length === 0 && !followingLoading}}">
      <text>暂无关注</text>
    </view>
  </view>

  <!-- 粉丝列表 -->
  <view class="list-wrapper" wx:if="{{currentTab === 'follower'}}">
    <scroll-view class="user-list" wx:if="{{followerList.length > 0}}" scroll-y enhanced show-scrollbar="{{false}}" bindscrolltolower="onFollowerScrollToLower" lower-threshold="100">
      <view class="user-item" wx:for="{{followerList}}" wx:key="uid">
        <image class="user-avatar" src="{{item.avatar}}" mode="aspectFill" catchtap="goToUserProfile" data-uid="{{item.uid}}" data-name="{{item.name}}" data-avatar="{{item.avatar}}"></image>
        <text class="user-name flex-1 ml-20 ellipsis">{{item.name}}</text>
        <view class="follow-btn {{item.isMutual ? 'followed' : ''}}" catchtap="toggleFollowerFollow" data-index="{{index}}">
          <text>{{item.isMutual ? '互关' : '关注'}}</text>
        </view>
      </view>

      <view class="loading-tip" wx:if="{{followerLoading}}">
        <text>加载中...</text>
      </view>

      <view class="loading-tip" wx:if="{{!followerHasMore && followerList.length > 0}}">
        <text>没有更多了</text>
      </view>
    </scroll-view>
    <view class="empty-state" wx:if="{{followerList.length === 0 && !followerLoading}}">
      <text>暂无粉丝</text>
    </view>
  </view>

  <view class="bottom-safe"></view>
</view>
