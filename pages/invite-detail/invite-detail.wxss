.page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background-color: var(--color-bg);
}

.status-bar-placeholder { background-color: var(--color-bg-white); }

.nav-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 24rpx;
  background-color: var(--color-bg-white);
  flex-shrink: 0;
}

.nav-back { width: 44rpx; height: 44rpx; }

.nav-title {
  font-size: var(--font-lg);
  font-weight: 600;
  color: var(--color-text);
}

.content { flex: 1; height: 0; }

.loading-wrap {
  display: flex;
  justify-content: center;
  padding-top: 120rpx;
}

.loading-text {
  font-size: var(--font-base);
}

.info-card {
  background-color: var(--color-bg-white);
  padding: 28rpx 24rpx;
  border-bottom: 1rpx solid var(--color-border-light);
}

.activity-title {
  font-size: var(--font-xl);
  font-weight: 700;
  color: var(--color-text);
  display: block;
  margin-bottom: 12rpx;
}

.activity-desc {
  font-size: var(--font-sm);
  line-height: 1.6;
  display: block;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: var(--font-base);
  font-weight: 600;
  color: var(--color-text);
  display: block;
  margin-bottom: 16rpx;
}

.info-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 14rpx 0;
  border-top: 1rpx solid var(--color-border-light);
}

.info-label {
  font-size: var(--font-sm);
  color: var(--color-text-secondary);
}

.info-value {
  font-size: var(--font-sm);
  color: var(--color-text);
}

.status-tag {
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  font-size: var(--font-xs);
}

.tag-green { background-color: #E8F8EE; color: var(--color-green); }
.tag-gray  { background-color: #F0F0F0; color: var(--color-text-secondary); }

.rule-item {
  display: flex;
  margin-bottom: 12rpx;
}

.rule-dot {
  font-size: var(--font-base);
  color: var(--color-primary);
  margin-right: 10rpx;
  flex-shrink: 0;
}

.rule-text {
  font-size: var(--font-sm);
  color: var(--color-text-secondary);
  line-height: 1.6;
}

.prize-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 0;
  border-bottom: 1rpx solid var(--color-border-light);
}

.prize-item:last-child { border-bottom: none; }

.prize-level {
  font-size: var(--font-base);
  font-weight: 600;
  color: var(--color-text);
  display: block;
  margin-bottom: 4rpx;
}

.prize-desc {
  font-size: var(--font-sm);
  display: block;
}

.winning-code {
  font-size: var(--font-base);
  font-weight: 700;
  color: var(--color-primary);
  letter-spacing: 4rpx;
}

.winner-label {
  font-size: var(--font-xs);
  padding: 4rpx 12rpx;
  border-radius: 20rpx;
}

.no-ticket {
  padding: 20rpx 0;
}

.ticket-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  padding-top: 4rpx;
}

.ticket-item {
  background-color: var(--color-bg);
  border-radius: var(--radius-sm);
  padding: 14rpx 20rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.ticket-code {
  font-size: var(--font-base);
  font-weight: 700;
  color: var(--color-primary);
  letter-spacing: 2rpx;
}

.ticket-source {
  font-size: var(--font-xs);
  margin-top: 4rpx;
}

.list-bottom { height: 40rpx; }

.bottom-bar {
  background-color: var(--color-bg-white);
  padding: 20rpx 24rpx;
  border-top: 1rpx solid var(--color-border-light);
  flex-shrink: 0;
}

.invite-code-row {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.invite-label {
  font-size: var(--font-sm);
  color: var(--color-text-secondary);
  margin-right: 16rpx;
}

.invite-code {
  font-size: var(--font-lg);
  font-weight: 700;
  color: var(--color-primary);
  letter-spacing: 4rpx;
  flex: 1;
}

.btn-copy {
  font-size: var(--font-sm);
  color: var(--color-primary);
  border: 1rpx solid var(--color-primary);
  padding: 8rpx 20rpx;
  border-radius: var(--radius-sm);
}

.btn-submit {
  background-color: var(--color-primary);
  color: #fff;
  text-align: center;
  padding: 24rpx 0;
  border-radius: var(--radius-lg);
  font-size: var(--font-base);
  font-weight: 600;
}

.share-native-button {
  margin: 0;
  width: 100%;
  border: 0;
  line-height: normal;
  box-sizing: border-box;
}

.share-native-button::after {
  border: 0;
}
