.page {
  min-height: 100vh;
  background-color: #F5F5F5;
  padding: 30rpx;
  box-sizing: border-box;
}

/* 当前额度 */
.quota-display {
  display: flex;
  align-items: center;
  margin-bottom: 30rpx;
}

.quota-label {
  font-size: 30rpx;
  color: #333333;
  font-weight: 500;
}

.quota-value {
  font-size: 30rpx;
  color: #255AC5;
  font-weight: 600;
}

/* 区域标题 */
.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333333;
  margin-bottom: 20rpx;
}

/* 充值选项列表 */
.options-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-bottom: 40rpx;
}

.option-card {
  display: flex;
  align-items: center;
  padding: 24rpx 30rpx;
  background-color: #FFFFFF;
  border-radius: 16rpx;
  border: 2rpx solid #F0F0F0;
}

.option-card.active {
  border-color: #255AC5;
  background-color: rgba(37, 90, 197, 0.05);
}

.option-icon {
  width: 40rpx;
  height: 40rpx;
  margin-right: 20rpx;
}

.option-label {
  font-size: 30rpx;
  color: #333333;
  font-weight: 500;
}

/* 自定义充值 */
.custom-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.price-tag {
  font-size: 24rpx;
  color: #FF6B6B;
  background: rgba(255, 107, 107, 0.1);
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
  font-weight: 500;
}

.custom-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 50rpx;
}

.custom-label {
  font-size: 30rpx;
  color: #333333;
  font-weight: 500;
}

.custom-input-box {
  display: flex;
  align-items: center;
  height: 72rpx;
  background-color: #FFFFFF;
  border: 2rpx solid #E0E0E0;
  border-radius: 12rpx;
  padding: 0 20rpx;
}

.custom-input {
  width: 120rpx;
  font-size: 28rpx;
  color: #333333;
  text-align: right;
}

.input-placeholder {
  color: #BBBBBB;
  font-size: 28rpx;
}

.input-unit {
  font-size: 28rpx;
  color: #666666;
  margin-left: 8rpx;
}

/* 充值按钮 */
.recharge-btn {
  width: 70%;
  height: 88rpx;
  margin: 0 auto;
  background-color: #4A4A4A;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  font-size: 32rpx;
  color: #FFFFFF;
  font-weight: 500;
}

.btn-icon {
  width: 32rpx;
  height: 32rpx;
}

/* 警告 */
.warning {
  margin-top: 30rpx;
  text-align: center;
}

.warning-text {
  font-size: 24rpx;
  color: #FF6B6B;
}
