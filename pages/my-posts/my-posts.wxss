/* 我的动态帖子 */
.page {
  height: 100vh;
  background-color: var(--color-bg);
}

.content-list {
  padding: 16rpx 30rpx;
}

.loading-state,
.empty-state {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
  font-size: var(--font-sm);
  color: var(--color-text-secondary);
}

.post-card {
  background-color: var(--color-bg-white);
  border-radius: var(--radius-md);
  padding: 24rpx;
  margin-bottom: 16rpx;
}

/* 帖子头部 */
.post-header {
  display: flex;
  align-items: center;
}

.post-avatar {
  width: 42rpx;
  height: 42rpx;
  border-radius: 50%;
  flex-shrink: 0;
  background: #CCCCCC;
}

.post-user-info {
  flex: 1;
  margin-left: 16rpx;
}

.post-user-name {
  font-size: var(--font-sm);
  color: var(--color-text);
  font-weight: 500;
  display: block;
}

.post-time {
  font-size: var(--font-xs);
  color: var(--color-text-secondary);
  display: block;
  margin-top: 4rpx;
}

.post-more {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.more-dots {
  font-size: var(--font-lg);
  color: var(--color-text-secondary);
  font-weight: 700;
}

/* 内容 */
.post-content-text {
  font-size: var(--font-sm);
  color: var(--color-text);
  line-height: 1.6;
  margin-top: 16rpx;
  display: -webkit-box;
  -webkit-line-clamp: 4;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

/* 图片 */
.post-images {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 16rpx;
}

.post-image {
  width: 160rpx;
  height: 160rpx;
  border-radius: var(--radius-sm);
  background: var(--color-bg);
}

/* 底部 */
.post-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 20rpx;
}

.post-stats {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.post-stat-item {
  display: flex;
  align-items: center;
}

.stat-icon {
  font-size: var(--font-xs);
  margin-right: 4rpx;
}

.stat-num {
  font-size: var(--font-xs);
  color: var(--color-text-secondary);
}

/* 商品状态标签 */
.item-status-tag {
  padding: 4rpx 16rpx;
  border-radius: var(--radius-sm);
  font-size: var(--font-xs);
  font-weight: 500;
}

.status-available {
  color: var(--color-green);
  background: rgba(20, 181, 84, 0.1);
}

.status-taken {
  color: var(--color-text-secondary);
  background: var(--color-bg);
}

/* 底部安全区 */
.bottom-safe {
  height: calc(20rpx + constant(safe-area-inset-bottom));
  height: calc(20rpx + env(safe-area-inset-bottom));
}
