<!-- 我的动态帖子 -->
<scroll-view class="page" scroll-y enhanced show-scrollbar="{{false}}" refresher-enabled refresher-triggered="{{refreshing}}" bindrefresherrefresh="onRefresh" bindscrolltolower="loadMore" lower-threshold="150">
  <view class="content-list" wx:if="{{posts.length > 0}}">
    <view class="post-card" wx:for="{{posts}}" wx:key="id" bindtap="goToDetail" data-id="{{item.id}}">
      <!-- 帖子头部 -->
      <view class="post-header">
        <image class="post-avatar" src="{{item.user.avatar}}" mode="aspectFill"></image>
        <view class="post-user-info">
          <text class="post-user-name">{{item.user.name}}</text>
          <text class="post-time">{{item.time}}</text>
        </view>
        <view class="post-more" catchtap="onShowActionSheet" data-id="{{item.id}}">
          <text class="more-dots">...</text>
        </view>
      </view>

      <!-- 内容 -->
      <text class="post-content-text">{{item.content}}</text>

      <!-- 图片 -->
      <view class="post-images" wx:if="{{item.images && item.images.length > 0}}">
        <image class="post-image" wx:for="{{item.images}}" wx:for-item="img" wx:for-index="imgIdx" wx:key="imgIdx" src="{{img}}" mode="aspectFill"></image>
      </view>

      <!-- 底部 -->
      <view class="post-footer">
        <view class="post-stats">
          <view class="post-stat-item">
            <text class="stat-icon">❤</text>
            <text class="stat-num">{{item.stats.likes}}</text>
          </view>
          <view class="post-stat-item">
            <text class="stat-icon">💬</text>
            <text class="stat-num">{{item.stats.comments}}</text>
          </view>
          <view class="post-stat-item" wx:if="{{item.stats.shares}}">
            <text class="stat-icon">📱</text>
            <text class="stat-num">{{item.stats.shares}}</text>
          </view>
        </view>
        <view class="item-status-tag status-{{item.itemStatus}}" wx:if="{{item.itemStatus}}">
          <text>{{item.itemStatus === 'available' ? '在售' : (item.itemStatus === 'taken' ? '已售出' : item.itemStatus)}}</text>
        </view>
      </view>
    </view>
    <!-- 加载更多提示 -->
    <view class="loading-state" wx:if="{{hasMore}}">
      <text>上拉加载更多</text>
    </view>
  </view>

  <view class="loading-state" wx:elif="{{loading}}">
    <text>加载中...</text>
  </view>

  <view class="empty-state" wx:else>
    <text>暂无动态帖子</text>
  </view>

  <view class="bottom-safe"></view>
</scroll-view>
