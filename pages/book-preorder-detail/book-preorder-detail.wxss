.page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background-color: var(--color-bg);
}

.status-bar-placeholder { background-color: var(--color-bg-white); }

.nav-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 24rpx;
  background-color: var(--color-bg-white);
  flex-shrink: 0;
}

.nav-back { width: 44rpx; height: 44rpx; }
.nav-placeholder { width: 44rpx; }

.nav-title {
  font-size: var(--font-lg);
  font-weight: 600;
  color: var(--color-text);
}

.content {
  flex: 1;
  height: 0;
}

.book-card, .info-card {
  background-color: var(--color-bg-white);
  margin: 16rpx 24rpx 0;
  border-radius: var(--radius-md);
  padding: 28rpx 24rpx;
}

.book-card {
  display: flex;
  align-items: flex-start;
  gap: 24rpx;
}

.book-cover {
  width: 180rpx;
  height: 240rpx;
  border-radius: var(--radius-sm);
  flex-shrink: 0;
}

.book-info {
  flex: 1;
  min-width: 0;
}

.book-name {
  font-size: var(--font-xl);
  font-weight: 700;
  color: var(--color-text);
  display: block;
  margin-bottom: 10rpx;
}

.book-meta {
  font-size: var(--font-sm);
  display: block;
  margin-bottom: 6rpx;
}

.price-block { margin-top: 20rpx; }

.price-main {
  font-size: var(--font-2xl);
  font-weight: 700;
  color: var(--color-red);
  display: block;
  margin-bottom: 6rpx;
}

.price-sub {
  font-size: var(--font-sm);
}

.section-title {
  font-size: var(--font-base);
  font-weight: 600;
  color: var(--color-text);
  display: block;
  margin-bottom: 16rpx;
}

.info-row, .order-no-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 14rpx 0;
  border-bottom: 1rpx solid var(--color-border-light);
}

.info-row:last-of-type, .order-no-row:last-of-type { border-bottom: none; }

.info-label {
  font-size: var(--font-sm);
  color: var(--color-text-secondary);
  flex-shrink: 0;
}

.info-value {
  font-size: var(--font-sm);
  color: var(--color-text);
  text-align: right;
  flex: 1;
  margin-left: 16rpx;
}

.status-tag {
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  font-size: var(--font-xs);
}

.tag-green { background-color: #E8F8EE; color: var(--color-green); }
.tag-gray  { background-color: #F0F0F0; color: var(--color-text-secondary); }

.desc-text {
  font-size: var(--font-sm);
  color: var(--color-text-secondary);
  line-height: 1.7;
}

.order-no { font-size: var(--font-xs); color: var(--color-text-secondary); }
.price-text { color: var(--color-red); font-weight: 600; }
.color-green { color: var(--color-green); }
.color-orange { color: var(--color-orange); }
.color-secondary { color: var(--color-text-secondary); }

.order-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 20rpx;
}

.btn-action {
  flex: 1;
  text-align: center;
  padding: 18rpx 0;
  border-radius: var(--radius-md);
  font-size: var(--font-sm);
  font-weight: 500;
}

.btn-primary-outline {
  border: 2rpx solid var(--color-primary);
  color: var(--color-primary);
}

.btn-cancel {
  border: 2rpx solid var(--color-border);
  color: var(--color-text-secondary);
}

.list-bottom { height: 40rpx; }

/* 底部下单栏 */
.bottom-bar {
  background-color: var(--color-bg-white);
  padding: 20rpx 24rpx;
  border-top: 1rpx solid var(--color-border-light);
  flex-shrink: 0;
}

.quantity-row {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.quantity-label {
  font-size: var(--font-base);
  color: var(--color-text);
  margin-right: 20rpx;
}

.quantity-ctrl {
  display: flex;
  align-items: center;
  gap: 0;
}

.qty-btn {
  width: 56rpx;
  height: 56rpx;
  border: 1rpx solid var(--color-border);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--font-xl);
  color: var(--color-text);
  border-radius: var(--radius-sm);
}

.qty-num {
  width: 72rpx;
  text-align: center;
  font-size: var(--font-lg);
  font-weight: 600;
}

.total-price {
  margin-left: auto;
  font-size: var(--font-xl);
  font-weight: 700;
  color: var(--color-red);
}

.btn-submit {
  background-color: var(--color-primary);
  color: #fff;
  text-align: center;
  padding: 24rpx 0;
  border-radius: var(--radius-lg);
  font-size: var(--font-base);
  font-weight: 600;
}
