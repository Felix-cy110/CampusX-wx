.page {
  min-height: 100vh;
  background-color: var(--color-bg);
  display: flex;
  flex-direction: column;
  align-items: center;
}

/* 成功区域 */
.success-area {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 120rpx;
  padding-bottom: 60rpx;
}

.checkmark-circle {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  background-color: var(--color-primary);
  display: flex;
  align-items: center;
  justify-content: center;
}

.checkmark {
  font-size: 72rpx;
  color: #FFFFFF;
  font-weight: 700;
}

.success-title {
  margin-top: 30rpx;
  font-size: var(--font-xl);
  font-weight: 700;
  color: var(--color-text);
}

/* 额度信息卡片 */
.info-card {
  width: 630rpx;
  background-color: var(--color-bg-white);
  border-radius: var(--radius-md);
  padding: 40rpx 36rpx;
  margin-top: 40rpx;
}

.info-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--color-border-light);
}

.info-row:last-child {
  border-bottom: none;
}

.info-label {
  font-size: var(--font-base);
  color: var(--color-text-secondary);
}

.info-value {
  font-size: var(--font-md);
  font-weight: 600;
  color: var(--color-text);
}

.info-value.primary {
  color: var(--color-primary);
  font-size: var(--font-lg);
}

/* 按钮区域 */
.btn-area {
  margin-top: 80rpx;
  padding: 0 30rpx;
  width: 100%;
  box-sizing: border-box;
}

.finish-btn {
  width: 100%;
  height: 88rpx;
  border-radius: var(--radius-md);
  background-color: var(--color-primary);
  display: flex;
  align-items: center;
  justify-content: center;
  color: #FFFFFF;
  font-size: var(--font-md);
  font-weight: 600;
}
