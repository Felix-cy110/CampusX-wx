.page {
  height: 100vh;
  background-color: #F5F5F5;
  display: flex;
  flex-direction: column;
}

.nav-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 24rpx;
  background: #fff;
  flex-shrink: 0;
}

.nav-back {
  width: 44rpx;
  height: 44rpx;
}

.nav-title {
  font-size: var(--font-lg);
  font-weight: 600;
  color: var(--color-text);
}

/* 搜索栏 */
.search-bar {
  padding: 40rpx 30rpx 16rpx;
  background-color: #FFFFFF;
  flex-shrink: 0;
}

.search-input {
  height: 72rpx;
  border-radius: 36rpx;
  background-color: #F5F5F5;
  display: flex;
  align-items: center;
  padding: 0 28rpx;
}

.search-icon {
  width: 28rpx;
  height: 28rpx;
  margin-right: 12rpx;
}

.search-field {
  flex: 1;
  font-size: 28rpx;
  color: #333333;
}

/* 左右分栏 */
.content {
  flex: 1;
  display: flex;
  overflow: hidden;
}

/* 左侧学期列表 */
.semester-list {
  width: 160rpx;
  height: 100%;
  background-color: #F5F5F5;
}

.semester-item {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 96rpx;
  padding: 0 20rpx;
}

.semester-item.active {
  background-color: #FFFFFF;
}

.semester-item.active .semester-name {
  font-weight: 600;
  color: #333333;
}

.semester-name {
  font-size: 26rpx;
  color: #666666;
}

/* 右侧书籍列表 */
.book-list {
  flex: 1;
  height: 100%;
  background-color: #FFFFFF;
}

.book-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 30rpx;
  border-bottom: 1rpx solid #F0F0F0;
}

.book-info {
  flex: 1;
  margin-right: 20rpx;
}

.book-title {
  font-size: 30rpx;
  color: #333333;
  font-weight: 600;
  display: block;
}

.book-publisher {
  font-size: 24rpx;
  color: #999999;
  margin-top: 8rpx;
  display: block;
}

.book-cover {
  width: 80rpx;
  height: 100rpx;
  border-radius: 8rpx;
  background-color: #F0F0F0;
  flex-shrink: 0;
}
