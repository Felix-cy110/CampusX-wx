<!-- 集市首页 -->
<view class="page">
  <!-- 正常内容 -->
    <!-- 固定顶部：状态栏 + 学校名 + 推荐/关注 -->
    <view class="fixed-header">
      <view class="status-bar-placeholder" style="height: {{statusBarHeight}}px;"></view>

      <view class="hero-nav-bar" style="height: {{navBarHeight}}px;">
        <view class="hero-school-row">
          <view class="hero-school" bindtap="switchSchool">
            <text class="hero-school-text">{{schoolInfo.name}}</text>
            <text class="hero-school-arrow">▼</text>
          </view>
        </view>
      </view>

      <view class="hero-sub-bar">
        <view class="hero-left-tabs">
          <text
            class="hero-feed-tab {{feedType === 'recommend' ? 'active' : ''}}"
            bindtap="switchFeedType"
            data-type="recommend"
          >推荐</text>
          <text
            class="hero-feed-tab {{feedType === 'follow' ? 'active' : ''}}"
            bindtap="switchFeedType"
            data-type="follow"
          >关注</text>
          <view class="hero-feed-indicator" style="left: calc(100% * {{feedIndicatorRatio}});"></view>
        </view>
        <view class="hero-right-actions">
          <view class="hero-action-btn" bindtap="goToSearch">
            <image class="hero-action-icon" src="/images/SVG/搜索.svg" mode="aspectFit"></image>
          </view>
          <view class="hero-action-btn" bindtap="goToInbox">
            <image class="hero-action-icon" src="/images/SVG/私信.svg" mode="aspectFit"></image>
          </view>
        </view>
      </view>
    </view>

    <!-- 可滚动内容 -->
    <swiper class="feed-swiper" current="{{feedSwiperIndex}}" bindchange="onFeedSwiperChange" easing-function="easeInOutCubic">
      <!-- 推荐页 -->
      <swiper-item>
        <view class="recommend-wrapper">
          <!-- 分类方块 -->
          <view class="category-squares">
            <view
              class="square-item {{currentTab === item.key ? 'square-selected' : ''}}"
              wx:for="{{categorySquares}}"
              wx:key="key"
              bindtap="switchTab"
              data-tab="{{item.key}}"
            >
              <image class="square-icon" src="{{item.icon}}" mode="aspectFit"></image>
              <text class="square-label">{{item.label}}</text>
            </view>
          </view>

          <!-- 二手二级分类 -->
          <view class="market-sub-tabs {{currentTab === 'market' && (innerSwiperIndex === 1 || innerSwiperIndex === 2) ? 'visible' : ''}}">
            <view
              class="market-sub-item {{marketSubTab === item.key ? 'active' : ''}}"
              wx:for="{{marketSubTabs}}"
              wx:key="key"
              bindtap="switchMarketSubTab"
              data-key="{{item.key}}"
            >
              <text class="market-sub-text">{{item.label}}</text>
            </view>
            <view class="market-sub-indicator" style="left: calc(30rpx + (100% - 60rpx) * {{marketIndicatorRatio}});"></view>
          </view>


          <!-- 内层 swiper：5 个分类面板 -->
          <swiper class="inner-swiper" current="{{innerSwiperIndex}}" bindchange="onInnerSwiperChange" easing-function="easeInOutCubic">
            <!-- 帖子 -->
            <swiper-item>
              <scroll-view class="panel-scroll" scroll-y enhanced show-scrollbar="{{false}}" enable-back-to-top refresher-enabled refresher-triggered="{{feedRefreshing}}" bindrefresherrefresh="refreshFeed">
                <view class="content-list">
                  <view class="feed-card" wx:for="{{feedList}}" wx:key="id" bindtap="goToPostDetail" data-id="{{item.id}}">
                    <view class="feed-card-header">
                      <image class="feed-card-avatar" src="{{item.user.avatar}}" mode="aspectFill" catchtap="goToUserProfile" data-uid="{{item.user.uid}}" data-name="{{item.user.name}}" data-avatar="{{item.user.avatar}}"></image>
                      <text class="feed-card-username">{{item.user.name}}</text>
                    </view>
                    <text class="feed-card-title">{{item.title}}</text>
                    <text class="feed-card-content ellipsis-2">{{item.content}}</text>
                    <view class="feed-card-images" wx:if="{{item.images && item.images.length > 0}}">
                      <image
                        wx:for="{{item.images}}"
                        wx:for-item="img"
                        wx:key="*this"
                        src="{{img}}"
                        mode="aspectFill"
                        class="feed-card-image {{item.images.length === 1 ? 'feed-card-image-single' : ''}}"
                      ></image>
                    </view>
                    <view class="feed-card-footer">
                      <view class="feed-card-tag">
                        <text class="feed-tag-text">{{item.school || ''}}</text>
                      </view>
                      <view class="feed-card-stats">
                        <view class="feed-stat-item">
                          <image class="feed-stat-icon" src="/images/SVG/评论.svg" mode="aspectFit"></image>
                          <text class="feed-stat-num">{{item.stats.comments}}</text>
                        </view>
                        <view class="feed-stat-item feed-like-btn" catchtap="toggleFeedLike" data-id="{{item.id}}" data-index="{{index}}" data-list="feedList">
                          <image class="feed-stat-icon" src="/images/SVG/{{item.liked ? '点赞-已赞' : '点赞'}}.svg" mode="aspectFit"></image>
                          <text class="feed-stat-num" style="color: {{item.liked ? 'var(--color-red)' : 'var(--color-text-secondary)'}};">{{item.stats.likes}}</text>
                        </view>
                      </view>
                    </view>
                  </view>
                  <view class="empty-state" wx:if="{{feedList.length === 0}}">
                    <text>暂无内容</text>
                  </view>
                </view>
              </scroll-view>
            </swiper-item>

            <!-- 二手-书籍 -->
            <swiper-item>
              <view class="book-market-panel">
                  <!-- 商品双列瀑布流 -->
                  <scroll-view
                    class="book-list-scroll"
                    scroll-y
                    enhanced
                    show-scrollbar="{{false}}"
                    enable-back-to-top
                    refresher-enabled
                    refresher-triggered="{{bookRefreshing}}"
                    bindrefresherrefresh="refreshBookList"
                    bindscrolltolower="loadMoreBooks"
                    lower-threshold="200"
                  >
                  <view class="book-waterfall" wx:if="{{bookDisplayList.length > 0}}">
                    <view class="book-column">
                      <view
                        class="book-card"
                        wx:for="{{bookDisplayList}}"
                        wx:key="id"
                        wx:if="{{index % 2 === 0}}"
                        bindtap="goToBookDetail"
                        data-id="{{item.id}}"
                      >
                        <view class="book-card-image-wrap">
                          <image class="book-card-image" src="{{item.images[0]}}" mode="aspectFill" wx:if="{{item.images && item.images.length > 0}}"></image>
                          <view class="book-card-image-placeholder" wx:else>
                            <text class="book-placeholder-icon">📚</text>
                          </view>
                          <view class="book-multi-badge" wx:if="{{item.images && item.images.length > 1}}">
                            <text class="book-multi-text">多图</text>
                          </view>
                          <view class="book-condition-tag">
                            <text>{{item.condition}}</text>
                          </view>
                          <view class="book-favorite-btn {{item.isFavorite ? 'active' : ''}}" catchtap="toggleBookFavorite" data-id="{{item.id}}">
                            <image class="book-favorite-icon" src="/images/SVG/收藏.svg" mode="aspectFit"></image>
                          </view>
                        </view>
                        <view class="book-card-body">
                          <text class="book-card-title ellipsis-2">{{item.title}}</text>
                          <view class="book-card-price-row">
                            <text class="book-card-price {{item.isFree ? 'free' : ''}}">{{item.isFree ? '免费' : '¥' + item.price}}</text>
                            <text class="book-card-original" wx:if="{{!item.isFree && item.originalPrice}}">原价 ¥{{item.originalPrice}}</text>
                          </view>
                          <view class="book-card-tags" wx:if="{{item.certTags && item.certTags.length > 0}}">
                            <text class="book-cert-tag" wx:for="{{item.certTags}}" wx:for-item="tag" wx:key="*this">{{tag}}</text>
                          </view>
                          <text class="book-card-extra">{{item.extraInfo}}</text>
                          <view class="book-card-seller">
                            <image class="book-seller-avatar" src="{{item.seller.avatar}}" mode="aspectFill" catchtap="goToUserProfile" data-uid="{{item.seller.uid}}" data-name="{{item.seller.name}}" data-avatar="{{item.seller.avatar}}"></image>
                            <text class="book-seller-name">{{item.seller.name}}</text>
                            <text class="book-seller-school" wx:if="{{item.distance}}">· {{item.distance}}</text>
                          </view>
                        </view>
                      </view>
                    </view>
                    <view class="book-column">
                      <view
                        class="book-card"
                        wx:for="{{bookDisplayList}}"
                        wx:key="id"
                        wx:if="{{index % 2 === 1}}"
                        bindtap="goToBookDetail"
                        data-id="{{item.id}}"
                      >
                        <view class="book-card-image-wrap">
                          <image class="book-card-image" src="{{item.images[0]}}" mode="aspectFill" wx:if="{{item.images && item.images.length > 0}}"></image>
                          <view class="book-card-image-placeholder" wx:else>
                            <text class="book-placeholder-icon">📚</text>
                          </view>
                          <view class="book-multi-badge" wx:if="{{item.images && item.images.length > 1}}">
                            <text class="book-multi-text">多图</text>
                          </view>
                          <view class="book-condition-tag">
                            <text>{{item.condition}}</text>
                          </view>
                          <view class="book-favorite-btn {{item.isFavorite ? 'active' : ''}}" catchtap="toggleBookFavorite" data-id="{{item.id}}">
                            <image class="book-favorite-icon" src="/images/SVG/收藏.svg" mode="aspectFit"></image>
                          </view>
                        </view>
                        <view class="book-card-body">
                          <text class="book-card-title ellipsis-2">{{item.title}}</text>
                          <view class="book-card-price-row">
                            <text class="book-card-price {{item.isFree ? 'free' : ''}}">{{item.isFree ? '免费' : '¥' + item.price}}</text>
                            <text class="book-card-original" wx:if="{{!item.isFree && item.originalPrice}}">原价 ¥{{item.originalPrice}}</text>
                          </view>
                          <view class="book-card-tags" wx:if="{{item.certTags && item.certTags.length > 0}}">
                            <text class="book-cert-tag" wx:for="{{item.certTags}}" wx:for-item="tag" wx:key="*this">{{tag}}</text>
                          </view>
                          <text class="book-card-extra">{{item.extraInfo}}</text>
                          <view class="book-card-seller">
                            <image class="book-seller-avatar" src="{{item.seller.avatar}}" mode="aspectFill" catchtap="goToUserProfile" data-uid="{{item.seller.uid}}" data-name="{{item.seller.name}}" data-avatar="{{item.seller.avatar}}"></image>
                            <text class="book-seller-name">{{item.seller.name}}</text>
                            <text class="book-seller-school" wx:if="{{item.distance}}">· {{item.distance}}</text>
                          </view>
                        </view>
                      </view>
                    </view>
                  </view>

                  <!-- 加载更多 / 空状态 -->
                  <view class="book-load-tip" wx:if="{{bookDisplayList.length > 0 && bookHasMore}}">
                    <text>加载中...</text>
                  </view>
                  <view class="book-load-tip" wx:if="{{bookDisplayList.length > 0 && !bookHasMore}}">
                    <text>没有更多书籍啦，去看看其他分类吧</text>
                  </view>
                  <view class="empty-state" wx:if="{{bookDisplayList.length === 0}}">
                    <text>暂无相关书籍</text>
                  </view>
                  </scroll-view>
              </view>
            </swiper-item>

            <!-- 二手-其他 -->
            <swiper-item>
              <view class="book-market-panel">
                <!-- 搜索栏 -->
                <view class="book-search-bar">
                  <view class="book-search-box">
                    <image class="book-search-icon" src="/images/SVG/搜索.svg" mode="aspectFit"></image>
                    <input
                      class="book-search-input"
                      placeholder="搜索商品 / 名称 / 标签"
                      placeholder-class="book-search-placeholder"
                      value="{{otherSearchKeyword}}"
                      bindinput="onOtherSearchInput"
                      bindconfirm="onOtherSearchConfirm"
                      confirm-type="search"
                    />
                    <view class="book-search-clear" wx:if="{{otherSearchKeyword}}" bindtap="onOtherSearchClear">
                      <text class="book-clear-text">×</text>
                    </view>
                  </view>
                </view>

                <!-- 分类标签 -->
                <view class="book-category-bar">
                  <scroll-view class="book-category-scroll" scroll-x enhanced show-scrollbar="{{false}}">
                    <view class="book-category-inner">
                      <view
                        class="book-category-item {{otherCurrentCategory === item.key ? 'active' : ''}}"
                        wx:for="{{otherCategories}}"
                        wx:key="key"
                        bindtap="switchOtherCategory"
                        data-key="{{item.key}}"
                      >
                        <text class="book-category-text">{{item.label}}</text>
                      </view>
                    </view>
                  </scroll-view>
                  <view class="book-category-shadow"></view>
                </view>

                <!-- 商品双列瀑布流 -->
                <scroll-view
                  class="book-list-scroll"
                  scroll-y
                  enhanced
                  show-scrollbar="{{false}}"
                  enable-back-to-top
                  refresher-enabled
                  refresher-triggered="{{otherRefreshing}}"
                  bindrefresherrefresh="refreshOtherList"
                  bindscrolltolower="loadMoreOther"
                  lower-threshold="200"
                >
                <view class="book-waterfall" wx:if="{{otherDisplayList.length > 0}}">
                  <view class="book-column">
                    <view
                      class="book-card"
                      wx:for="{{otherDisplayList}}"
                      wx:key="id"
                      wx:if="{{index % 2 === 0}}"
                      bindtap="goToMarketDetail"
                      data-id="{{item.id}}"
                    >
                      <view class="book-card-image-wrap">
                        <image class="book-card-image" src="{{item.images[0]}}" mode="aspectFill" wx:if="{{item.images && item.images.length > 0}}"></image>
                        <view class="book-card-image-placeholder" wx:else>
                          <text class="book-placeholder-icon">📦</text>
                        </view>
                        <view class="book-condition-tag">
                          <text>{{item.condition}}</text>
                        </view>
                        <view class="book-favorite-btn {{item.isFavorite ? 'active' : ''}}" catchtap="toggleOtherFavorite" data-id="{{item.id}}">
                          <image class="book-favorite-icon" src="/images/SVG/收藏.svg" mode="aspectFit"></image>
                        </view>
                      </view>
                      <view class="book-card-body">
                        <text class="book-card-title ellipsis-2">{{item.title}}</text>
                        <view class="book-card-price-row">
                          <text class="book-card-price {{item.isFree ? 'free' : ''}}">{{item.isFree ? '免费' : '¥' + item.price}}</text>
                          <text class="book-card-original" wx:if="{{!item.isFree && item.originalPrice}}">原价 ¥{{item.originalPrice}}</text>
                        </view>
                        <text class="book-card-extra">{{item.extraInfo}}</text>
                        <view class="book-card-seller">
                          <image class="book-seller-avatar" src="{{item.seller.avatar}}" mode="aspectFill" catchtap="goToUserProfile" data-uid="{{item.seller.uid}}" data-name="{{item.seller.name}}" data-avatar="{{item.seller.avatar}}"></image>
                          <text class="book-seller-name">{{item.seller.name}}</text>
                        </view>
                      </view>
                    </view>
                  </view>
                  <view class="book-column">
                    <view
                      class="book-card"
                      wx:for="{{otherDisplayList}}"
                      wx:key="id"
                      wx:if="{{index % 2 === 1}}"
                      bindtap="goToMarketDetail"
                      data-id="{{item.id}}"
                    >
                      <view class="book-card-image-wrap">
                        <image class="book-card-image" src="{{item.images[0]}}" mode="aspectFill" wx:if="{{item.images && item.images.length > 0}}"></image>
                        <view class="book-card-image-placeholder" wx:else>
                          <text class="book-placeholder-icon">📦</text>
                        </view>
                        <view class="book-condition-tag">
                          <text>{{item.condition}}</text>
                        </view>
                        <view class="book-favorite-btn {{item.isFavorite ? 'active' : ''}}" catchtap="toggleOtherFavorite" data-id="{{item.id}}">
                          <image class="book-favorite-icon" src="/images/SVG/收藏.svg" mode="aspectFit"></image>
                        </view>
                      </view>
                      <view class="book-card-body">
                        <text class="book-card-title ellipsis-2">{{item.title}}</text>
                        <view class="book-card-price-row">
                          <text class="book-card-price {{item.isFree ? 'free' : ''}}">{{item.isFree ? '免费' : '¥' + item.price}}</text>
                          <text class="book-card-original" wx:if="{{!item.isFree && item.originalPrice}}">原价 ¥{{item.originalPrice}}</text>
                        </view>
                        <text class="book-card-extra">{{item.extraInfo}}</text>
                        <view class="book-card-seller">
                          <image class="book-seller-avatar" src="{{item.seller.avatar}}" mode="aspectFill" catchtap="goToUserProfile" data-uid="{{item.seller.uid}}" data-name="{{item.seller.name}}" data-avatar="{{item.seller.avatar}}"></image>
                          <text class="book-seller-name">{{item.seller.name}}</text>
                        </view>
                      </view>
                    </view>
                  </view>
                </view>

                <!-- 加载更多 / 空状态 -->
                <view class="book-load-tip" wx:if="{{otherDisplayList.length > 0 && otherHasMore}}">
                  <text>加载中...</text>
                </view>
                <view class="book-load-tip" wx:if="{{otherDisplayList.length > 0 && !otherHasMore}}">
                  <text>没有更多啦</text>
                </view>
                <view class="empty-state" wx:if="{{otherDisplayList.length === 0}}">
                  <text>暂无相关商品</text>
                </view>
                </scroll-view>
              </view>
            </swiper-item>

            <!-- 跑腿 -->
            <swiper-item>
              <!-- 跑腿子 tab：需求 / 供给 -->
              <view class="errand-sub-tabs">
                <view class="errand-sub-tab {{errandSubTab === 'demand' ? 'active' : ''}}" bindtap="switchErrandSubTab" data-tab="demand">
                  <text>需求</text>
                </view>
                <view class="errand-sub-tab {{errandSubTab === 'supply' ? 'active' : ''}}" bindtap="switchErrandSubTab" data-tab="supply">
                  <text>供给</text>
                </view>
              </view>
              <scroll-view class="panel-scroll" scroll-y enhanced show-scrollbar="{{false}}" enable-back-to-top refresher-enabled refresher-triggered="{{errandRefreshing}}" bindrefresherrefresh="refreshErrands" bindscrolltolower="loadMoreErrands" lower-threshold="200">
                <view class="content-list">
                  <!-- 需求列表 -->
                  <block wx:if="{{errandSubTab === 'demand'}}">
                    <view class="product-card errand-card" wx:for="{{errandList}}" wx:key="id" bindtap="goToErrandDetail" data-id="{{item.id}}">
                      <!-- 顶部紧急栏：倒计时 + 报酬 -->
                      <view class="errand-urgent-bar">
                        <view class="errand-countdown-tag" wx:if="{{item.countdown}}">
                          <text class="errand-countdown-tag-text">{{item.countdown}}</text>
                        </view>
                        <view class="errand-reward" wx:if="{{item.reward}}">
                          <text class="errand-reward-symbol">¥</text>
                          <text class="errand-reward-num">{{item.reward}}</text>
                        </view>
                      </view>

                      <!-- 课程核心信息 -->
                      <view class="errand-body">
                        <text class="errand-course-name" wx:if="{{item.title}}">{{item.title}}</text>
                        <view class="errand-dest-row" wx:if="{{item.location}}">
                          <image class="errand-dest-icon" src="/images/SVG/地址.svg" mode="aspectFit"></image>
                          <text class="errand-dest-text">{{item.location}}</text>
                        </view>
                        <view class="errand-info-row" wx:if="{{item.classTime}}">
                          <image class="errand-info-icon" src="/images/SVG/时间.svg" mode="aspectFit"></image>
                          <text class="errand-info-text">{{item.classTime}}</text>
                        </view>
                        <text class="errand-remark" wx:if="{{item.remark}}">{{item.remark}}</text>
                      </view>

                      <!-- 底部：发布者 + 行动按钮 -->
                      <view class="errand-action-bar">
                        <view class="errand-publisher">
                          <image class="errand-publisher-avatar" src="{{item.user.avatar}}" mode="aspectFill" catchtap="goToUserProfile" data-uid="{{item.user.uid}}" data-name="{{item.user.name}}" data-avatar="{{item.user.avatar}}"></image>
                          <text class="errand-publisher-name">{{item.user.name}}</text>
                          <text class="errand-publisher-time">{{item.time}}</text>
                        </view>
                        <view class="errand-btn-group">
                          <view class="errand-btn errand-btn-left" catchtap="contactErrandUser" data-user-id="{{item.user.uid || ''}}" data-name="{{item.user.name}}" data-avatar="{{item.user.avatar}}">
                            <text>联系</text>
                          </view>
                          <view class="errand-btn errand-btn-right" catchtap="grabErrand" data-id="{{item.id}}">
                            <text>抢单</text>
                          </view>
                        </view>
                      </view>
                    </view>
                    <view class="load-more-tip" wx:if="{{errandHasMore && errandList.length > 0}}">
                      <text>上拉加载更多</text>
                    </view>
                    <view class="empty-state" wx:if="{{errandList.length === 0}}">
                      <text>暂无跑腿任务</text>
                    </view>
                  </block>

                  <!-- 供给列表 -->
                  <block wx:if="{{errandSubTab === 'supply'}}">
                    <view class="product-card errand-card" wx:for="{{supplyList}}" wx:key="id" bindtap="goToSupplyDetail" data-id="{{item.id}}">
                      <view class="errand-urgent-bar">
                        <view class="errand-reward" wx:if="{{item.reward}}">
                          <text class="errand-reward-symbol">¥</text>
                          <text class="errand-reward-num">{{item.reward}}</text>
                          <text class="errand-reward-unit">/次</text>
                        </view>
                      </view>
                      <view class="errand-body">
                        <text class="errand-course-name" wx:if="{{item.title}}">{{item.title}}</text>
                        <view class="errand-info-row" wx:if="{{item.classTime}}">
                          <image class="errand-info-icon" src="/images/SVG/时间.svg" mode="aspectFit"></image>
                          <text class="errand-info-text">{{item.classTime}}</text>
                        </view>
                      </view>
                      <view class="errand-action-bar">
                        <view class="errand-publisher">
                          <image class="errand-publisher-avatar" src="{{item.user.avatar}}" mode="aspectFill" catchtap="goToUserProfile" data-uid="{{item.user.uid}}" data-name="{{item.user.name}}" data-avatar="{{item.user.avatar}}"></image>
                          <text class="errand-publisher-name">{{item.user.name}}</text>
                          <text class="errand-publisher-time">{{item.time}}</text>
                        </view>
                        <view class="errand-btn-group">
                          <view class="errand-btn errand-btn-left" catchtap="contactErrandUser" data-user-id="{{item.user.uid || ''}}" data-name="{{item.user.name}}" data-avatar="{{item.user.avatar}}">
                            <text>联系</text>
                          </view>
                        </view>
                      </view>
                    </view>
                    <view class="load-more-tip" wx:if="{{supplyHasMore && supplyList.length > 0}}">
                      <text>上拉加载更多</text>
                    </view>
                    <view class="empty-state" wx:if="{{supplyList.length === 0}}">
                      <text>暂无代课供给</text>
                    </view>
                  </block>
                </view>
              </scroll-view>
            </swiper-item>

            <!-- 评分 -->
            <swiper-item>
              <scroll-view class="panel-scroll" scroll-y enhanced show-scrollbar="{{false}}" enable-back-to-top refresher-enabled refresher-triggered="{{teacherRefreshing}}" bindrefresherrefresh="refreshTeacherRatings">
                <view class="content-list">
                  <view
                    class="rating-teacher-card"
                    wx:for="{{teacherRatingList}}"
                    wx:key="id"
                  >
                    <view
                      class="rtc-header"
                      bindtap="toggleTeacherExpand"
                      data-id="{{item.id}}"
                    >
                      <view class="rtc-avatar">{{item.name[0]}}</view>
                      <view class="rtc-info">
                        <text class="rtc-name">{{item.name}}</text>
                        <view class="rtc-stats">
                          <text class="rtc-avg" wx:if="{{item.avgScore}}">★ {{item.avgScore}} 分</text>
                          <text class="rtc-count">{{item.ratingCount || 0}} 条评价</text>
                        </view>
                      </view>
                      <text class="rtc-arrow {{expandedTeacherId === item.id ? 'rotated' : ''}}">›</text>
                    </view>
                    <view class="rtc-courses-dropdown {{expandedTeacherId === item.id ? 'visible' : ''}}">
                      <view
                        class="rtc-course-item"
                        wx:for="{{item.courses}}"
                        wx:for-item="course"
                        wx:key="id"
                        catchtap="goToCourseRating"
                        data-teacher-id="{{item.id}}"
                        data-teacher-name="{{item.name}}"
                        data-teacher-avgscore="{{item.avgScore}}"
                        data-course-id="{{course.id}}"
                        data-course-name="{{course.courseName}}"
                        data-course-avgscore="{{course.avgScore}}"
                      >
                        <view class="rtc-course-left">
                          <text class="rtc-course-name">{{course.courseName}}</text>
                          <text class="rtc-course-score" wx:if="{{course.avgScore}}">★ {{course.avgScore}}</text>
                        </view>
                        <text class="rtc-course-arrow">›</text>
                      </view>
                      <view class="rtc-courses-empty" wx:if="{{!item.courses || item.courses.length === 0}}">
                        <text>暂无课程信息</text>
                      </view>
                    </view>
                  </view>
                  <view class="empty-state" wx:if="{{teacherRatingList.length === 0}}">
                    <text wx:if="{{teacherLoading}}">加载中...</text>
                    <text wx:else>暂无教师评分</text>
                  </view>
                </view>
              </scroll-view>
            </swiper-item>
          </swiper>
        </view>
      </swiper-item>

      <!-- 关注页 -->
      <swiper-item>
        <scroll-view
          class="page-content"
          scroll-y
          enhanced
          scroll-top="{{_followScrollTop}}"
          show-scrollbar="{{false}}"
          enable-back-to-top
          bindscrolltolower="loadMoreFollowing"
          lower-threshold="200"
          refresher-enabled
          refresher-triggered="{{_followRefreshing}}"
          bindrefresherrefresh="refreshFollowing"
        >
          <!-- 关注用户头像栏 -->
          <view class="follow-avatars-bar">
            <scroll-view class="follow-avatars-scroll" scroll-x enhanced show-scrollbar="{{false}}">
              <view class="follow-avatars-inner">
                <view
                  class="follow-avatar-item"
                  wx:for="{{followingUsers}}"
                  wx:key="uid"
                  bindtap="goToUserProfile"
                  data-uid="{{item.uid}}"
                  data-name="{{item.name}}"
                  data-avatar="{{item.avatar}}"
                >
                  <view class="follow-avatar-wrap">
                    <image class="follow-avatar-img" src="{{item.avatar}}" mode="aspectFill"></image>
                    <view class="follow-avatar-dot" wx:if="{{item.hasNew}}"></view>
                  </view>
                  <text class="follow-avatar-name ellipsis">{{item.name}}</text>
                </view>
              </view>
            </scroll-view>
          </view>

          <!-- 关注动态列表 -->
          <view class="content-list">
            <view class="feed-card" wx:for="{{followingPosts}}" wx:key="id" bindtap="goToPostDetail" data-id="{{item.id}}">
              <view class="feed-card-header">
                <image class="feed-card-avatar" src="{{item.user.avatar}}" mode="aspectFill" catchtap="goToUserProfile" data-uid="{{item.user.uid}}" data-name="{{item.user.name}}" data-avatar="{{item.user.avatar}}"></image>
                <text class="feed-card-username">{{item.user.name}}</text>
              </view>
              <text class="feed-card-title">{{item.title}}</text>
              <text class="feed-card-content ellipsis-2">{{item.content}}</text>
              <view class="feed-card-images" wx:if="{{item.images && item.images.length > 0}}">
                <image
                  wx:for="{{item.images}}"
                  wx:for-item="img"
                  wx:key="*this"
                  src="{{img}}"
                  mode="aspectFill"
                  class="feed-card-image {{item.images.length === 1 ? 'feed-card-image-single' : ''}}"
                ></image>
              </view>
              <view class="feed-card-footer">
                <view class="feed-card-tag">
                  <text class="feed-tag-text">{{item.school || ''}}</text>
                </view>
                <view class="feed-card-stats">
                  <view class="feed-stat-item">
                    <image class="feed-stat-icon" src="/images/SVG/评论.svg" mode="aspectFit"></image>
                    <text class="feed-stat-num">{{item.stats.comments}}</text>
                  </view>
                  <view class="feed-stat-item feed-like-btn" catchtap="toggleFeedLike" data-id="{{item.id}}" data-index="{{index}}" data-list="followingPosts">
                    <image class="feed-stat-icon" src="/images/SVG/{{item.liked ? '点赞-已赞' : '点赞'}}.svg" mode="aspectFit"></image>
                    <text class="feed-stat-num" style="color: {{item.liked ? 'var(--color-red)' : 'var(--color-text-secondary)'}};">{{item.stats.likes}}</text>
                  </view>
                </view>
              </view>
            </view>
            <view class="load-more-tip" wx:if="{{_followHasMore && followingPosts.length > 0}}">
              <text>上拉加载更多</text>
            </view>
            <view class="empty-state" wx:if="{{followingPosts.length === 0}}">
              <text>关注的人暂无动态</text>
            </view>
          </view>
        </scroll-view>
      </swiper-item>
    </swiper>

</view>
