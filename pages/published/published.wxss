/* 已发布确认页 */
.page {
  min-height: 100vh;
  background: var(--color-bg-white);
  display: flex;
  flex-direction: column;
}

/* ===== 导航栏 ===== */
.fixed-header {
  flex-shrink: 0;
}
.status-bar-placeholder {
  width: 100%;
  background-color: #FFFFFF;
}
.nav-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 30rpx;
  background-color: #FFFFFF;
}
.nav-back {
  width: 80rpx;
  height: 100%;
  display: flex;
  align-items: center;
}
.nav-back-icon {
  width: 40rpx;
  height: 40rpx;
}
.nav-title {
  font-size: var(--font-lg);
  font-weight: 600;
  color: var(--color-text);
}
.nav-placeholder {
  width: 80rpx;
}

/* ===== 内容区域 ===== */
.container {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 60rpx 40rpx;
  width: 100%;
  box-sizing: border-box;
}

/* 成功图标 */
.check-area {
  margin-bottom: 40rpx;
}

.check-circle {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  background: var(--color-green);
  display: flex;
  align-items: center;
  justify-content: center;
}

.check-icon {
  font-size: 72rpx;
  color: #FFFFFF;
  font-weight: 700;
}

/* 标题 */
.done-title {
  font-size: var(--font-3xl);
  font-weight: 700;
  color: var(--color-text);
  margin-bottom: 40rpx;
}

/* 说明区域 */
.notice-area {
  text-align: center;
  margin-bottom: 60rpx;
}

.notice-title {
  font-size: var(--font-md);
  font-weight: 600;
  color: var(--color-text);
  display: block;
  margin-bottom: 16rpx;
}

.notice-desc {
  font-size: var(--font-sm);
  color: var(--color-text-secondary);
  display: block;
  line-height: 1.6;
}

/* 完成按钮 */
.done-btn {
  width: 100%;
}

/* 底部安全区 */
.bottom-safe {
  height: calc(20rpx + constant(safe-area-inset-bottom));
  height: calc(20rpx + env(safe-area-inset-bottom));
}
