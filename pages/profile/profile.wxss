/* 个人资料页 - 匹配 Sketch 集市画板设计 */

.page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: var(--color-bg);
}

/* ========== 固定头部 ========== */
.fixed-header {
  flex-shrink: 0;
  background: #255AC5;
  position: relative;
  z-index: 100;
}

.status-bar-placeholder {
  width: 100%;
  background: #255AC5;
}

.top-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 30rpx;
}

.top-bar-left {
  display: flex;
  align-items: center;
  padding: 0 20rpx;
  box-sizing: border-box;
  background: rgba(255, 255, 255, 0.6);
  /* 高度与圆角由 JS 按胶囊按钮实际高度内联设置 */
}

.top-bar-text {
  font-size: var(--font-sm);
  color: var(--color-text);
  font-weight: 500;
}

image.icon-bag {
  width: 32rpx;
  height: 32rpx;
  margin-right: 6rpx;
}

.top-bar-right {
  display: flex;
  align-items: center;
  gap: 16rpx;
  /* 右边距由 JS 根据胶囊按钮实际位置动态计算（capsuleGap），避开右上角胶囊 */
}

.top-edit-btn {
  display: flex;
  align-items: center;
  padding: 0 20rpx;
  box-sizing: border-box;
  background: rgba(255, 255, 255, 0.6);
  /* 高度与圆角由 JS 按胶囊按钮实际高度内联设置 */
}

.top-edit-btn .icon-edit {
  font-size: 30rpx;
  margin-right: 6rpx;
}

.top-bar-text-white {
  font-size: var(--font-sm);
  color: #FFFFFF;
}

.top-settings-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.6);
  border-radius: 50%;
  /* 宽高由 JS 按胶囊按钮实际高度内联设置 */
}

.icon-settings {
  width: 32rpx;
  height: 32rpx;
}

/* ========== 帖子列表滚动区域 ========== */
.post-list-scroll {
  flex: 1;
  height: 0;
}

/* ========== 顶部渐变背景区域 ========== */
.profile-header-bg {
  background: linear-gradient(180deg, #255AC5 0%, #5985D8 60%, var(--color-bg) 100%);
  padding-bottom: 0;
  padding-top: 16rpx;
}

/* ========== 头像区域 ========== */
.avatar-section {
  display: flex;
  align-items: flex-start;
  padding: 20rpx 30rpx 0;
}

.profile-avatar {
  width: 122rpx;
  height: 122rpx;
  border-radius: 50%;
  background: #CCCCCC;
  flex-shrink: 0;
}

.name-area {
  margin-left: 24rpx;
  flex: 1;
  overflow: hidden;
}

.name-row {
  display: flex;
  align-items: center;
}

.profile-name {
  font-size: var(--font-2xl);
  font-weight: 700;
  color: #FFFFFF;
}

.gender-icon {
  width: 28rpx;
  height: 28rpx;
  margin-left: 10rpx;
}

.profile-uid {
  font-size: var(--font-sm);
  color: rgba(255, 255, 255, 0.7);
  margin-top: 8rpx;
}

/* 学校标签 */
.school-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 12rpx;
}

.school-tag {
  font-size: var(--font-xs);
  color: rgba(255, 255, 255, 0.9);
  background: rgba(255, 255, 255, 0.2);
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  line-height: 1.4;
}



/* ========== 关注统计行 ========== */
.stats-row {
  display: flex;
  align-items: center;
  justify-content: flex-start;
  padding: 24rpx 30rpx 20rpx;
}

.stats-item {
  display: flex;
  align-items: baseline;
  padding: 0 24rpx;
}

.stats-item:active {
  opacity: 0.7;
}

.stats-num {
  font-size: var(--font-lg);
  font-weight: 700;
  color: #FFFFFF;
}

.stats-label {
  font-size: var(--font-sm);
  color: rgba(255, 255, 255, 0.7);
  margin-left: 6rpx;
}

/* ========== 状态卡片 & 签名卡片（半透明白底） ========== */
.info-card {
  margin: 0;
  padding: 20rpx 30rpx;
  background: rgba(255, 255, 255, 0.6);
  border-radius: 0;
}

.card-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.card-left {
  display: flex;
  align-items: center;
  flex: 1;
  overflow: hidden;
}

.card-emoji {
  font-size: var(--font-lg);
  margin-right: 10rpx;
  flex-shrink: 0;
}

.card-text {
  font-size: var(--font-base);
  color: var(--color-text);
  font-weight: 500;
}

.card-link {
  font-size: var(--font-sm);
  color: var(--color-primary);
  flex-shrink: 0;
  margin-left: 20rpx;
}

/* 签名卡片特有 */
.signature-left {
  align-items: flex-start;
}

.quote-icon {
  font-size: var(--font-xl);
  color: var(--color-text-secondary);
  margin-right: 10rpx;
  flex-shrink: 0;
  line-height: 1;
}

.signature-text {
  font-size: var(--font-sm);
  color: var(--color-text-secondary);
  line-height: 1.6;
  display: -webkit-box;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

/* 邀请码卡片 */
.invite-card .invite-code {
  font-weight: 700;
  color: var(--color-primary);
  letter-spacing: 2rpx;
}

.invite-desc {
  margin-top: 8rpx;
  padding-left: 46rpx;
  font-size: var(--font-xs);
  color: var(--color-text-secondary);
}

/* ========== 功能按钮 ========== */
.func-btns {
  display: flex;
  margin: 0;
  gap: 0;
}

.func-btn {
  flex: 1;
  min-height: 86rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.6);
  border-radius: 0;
  padding: 12rpx 4rpx;
}

image.func-icon {
  width: 36rpx;
  height: 36rpx;
  margin-bottom: 4rpx;
}

.func-icon {
  font-size: var(--font-lg);
  margin-bottom: 4rpx;
}

.func-label {
  font-size: var(--font-xs);
  color: var(--color-text-dark);
  font-weight: 500;
}

.func-sub {
  font-size: 18rpx;
  color: var(--color-text-secondary);
  margin-top: 2rpx;
  line-height: 1.2;
}

.func-sub.available {
  color: var(--color-green);
}

/* ========== 子Tab：我发布的 / 我的收藏 ========== */
.sub-tabs {
  display: flex;
  background: var(--color-bg-white);
  border-radius: 0;
  overflow: hidden;
  border: none;
  border-bottom: 1rpx solid var(--color-border-light);
  position: relative;
}

.sub-tab {
  flex: 1;
  height: 56rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  position: relative;
  font-size: var(--font-sm);
  color: var(--color-text-secondary);
}

.sub-tab.active {
  color: var(--color-primary);
  font-weight: 600;
}

.sub-tab-indicator {
  position: absolute;
  bottom: 0;
  left: 0;
  transform: translateX(-50%);
  width: 48rpx;
  height: 4rpx;
  background: var(--color-primary);
  border-radius: 2rpx;
  transition: left 0.35s cubic-bezier(0.32, 0.72, 0, 1);
}

/* ========== 帖子列表 ========== */
.post-list {
  background: var(--color-bg-white);
  padding: 10rpx 24rpx 0;
  min-height: 60vh;
  display: flex;
  flex-direction: column;
}

.post-card {
  padding: 24rpx 0;
  position: relative;
}

.post-card + .post-card {
  border-top: 1rpx solid var(--color-border-light);
}

/* 置顶帖子 */
.post-pinned {
  background: rgba(37, 90, 197, 0.03);
  margin: 0 -24rpx;
  padding-left: 24rpx;
  padding-right: 24rpx;
  border-radius: var(--radius-sm);
}

/* 帖子标签（置顶） */
.post-badges {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-bottom: 14rpx;
  flex-wrap: wrap;
}

.post-badge {
  display: inline-flex;
  align-items: center;
  padding: 4rpx 14rpx;
  border-radius: 6rpx;
}

.post-badge .badge-text {
  font-size: var(--font-xs);
  font-weight: 500;
}

.badge-pinned {
  background: rgba(255, 120, 120, 0.1);
}

.badge-pinned .badge-text {
  color: var(--color-red);
}

/* 帖子头部 */
.post-header {
  display: flex;
  align-items: center;
}

.post-avatar {
  width: 42rpx;
  height: 42rpx;
  border-radius: 50%;
  flex-shrink: 0;
  background: #CCCCCC;
}

.post-user-info {
  flex: 1;
  margin-left: 16rpx;
}

.post-user-name {
  font-size: var(--font-sm);
  color: var(--color-text);
  font-weight: 500;
  display: block;
}

.post-time {
  font-size: var(--font-xs);
  color: var(--color-text-secondary);
  display: block;
  margin-top: 4rpx;
}

.post-more {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.more-dots {
  font-size: var(--font-lg);
  color: var(--color-text-secondary);
  font-weight: 700;
}

/* 帖子内容 */
.post-content-text {
  font-size: var(--font-sm);
  color: var(--color-text);
  line-height: 1.6;
  margin-top: 16rpx;
  display: -webkit-box;
  -webkit-line-clamp: 4;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

/* 帖子图片 */
.post-images {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 16rpx;
}

.post-image {
  width: 160rpx;
  height: 160rpx;
  border-radius: var(--radius-sm);
  background: var(--color-bg);
}

/* 帖子底部 */
.post-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 20rpx;
}

.post-stats {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.post-stat-item {
  display: flex;
  align-items: center;
}

.stat-icon {
  width: 28rpx;
  height: 28rpx;
  margin-right: 4rpx;
}

.stat-num {
  font-size: var(--font-xs);
  color: var(--color-text-secondary);
}

/* 商品状态标签 */
.item-status-tag {
  padding: 4rpx 16rpx;
  border-radius: var(--radius-sm);
  font-size: var(--font-xs);
  font-weight: 500;
}

.status-available {
  color: var(--color-green);
  background: rgba(20, 181, 84, 0.1);
}

.status-taken,
.status-sold,
.status-off-shelf {
  color: var(--color-text-secondary);
  background: var(--color-bg);
}

.status-completed {
  color: var(--color-green);
  background: rgba(20, 181, 84, 0.1);
}

.status-closed {
  color: var(--color-text-secondary);
  background: var(--color-bg);
}

.status-pending {
  color: var(--color-orange);
  background: rgba(255, 122, 0, 0.1);
}

.status-rejected {
  color: var(--color-red);
  background: rgba(255, 77, 79, 0.1);
}

/* ========== 底部安全区 ========== */
.bottom-safe {
  height: calc(120rpx + constant(safe-area-inset-bottom));
  height: calc(120rpx + env(safe-area-inset-bottom));
}

/* ========== 空状态 ========== */
.empty-state {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--color-text-secondary);
  font-size: var(--font-sm);
}

/* ========== 未登录 ========== */
.not-logged-in {
  padding: 40rpx 30rpx;
}

/* ========== 帖子选项弹窗 ========== */
.post-options-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0);
  z-index: 1200;
  pointer-events: none;
  transition: background 0.3s ease;
}

.post-options-mask.show {
  background: rgba(0, 0, 0, 0.5);
  pointer-events: auto;
}

.post-options-sheet {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  background: var(--color-bg-white);
  border-radius: var(--radius-lg) var(--radius-lg) 0 0;
  padding: 32rpx 30rpx calc(48rpx + env(safe-area-inset-bottom));
  max-height: 82vh;
  box-sizing: border-box;
  transform: translateY(100%);
  transition: transform 0.3s ease;
  display: flex;
  flex-direction: column;
}

.post-options-sheet.show {
  transform: translateY(0);
}

.post-options-title {
  font-size: var(--font-lg);
  font-weight: 700;
  color: var(--color-text);
  margin-bottom: 24rpx;
  padding-left: 10rpx;
  flex-shrink: 0;
}

.post-options-scroll {
  max-height: calc(82vh - 120rpx - env(safe-area-inset-bottom));
}

.post-options-list {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
}

.post-option-btn {
  width: 520rpx;
  height: 80rpx;
  border-radius: var(--radius-md);
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
}

.post-option-btn:active {
  opacity: 0.85;
}

.share-native-button {
  margin-left: 0;
  margin-right: 0;
  padding: 0;
  border: 0;
  box-sizing: border-box;
  line-height: normal;
}

.share-native-button::after {
  border: 0;
}

.post-option-btn .option-icon {
  width: 32rpx;
  height: 32rpx;
}

.post-option-btn .option-text {
  font-size: var(--font-sm);
  font-weight: 500;
  color: #FFFFFF;
}

.post-option-btn.btn-gray {
  background: #3B3B3B;
}

.post-option-btn.btn-green {
  background: var(--color-green);
}

.post-option-btn.btn-red {
  background: #FF7075;
}

/* 加载更多提示 */
.load-more-hint {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 24rpx 0;
}

.load-more-hint text {
  font-size: var(--font-xs);
  color: var(--color-text-secondary);
}
