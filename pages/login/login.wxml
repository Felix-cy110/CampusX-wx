<!-- 登录页面 -->
<view class="page">
  <view class="status-bar-placeholder" style="height: {{statusBarHeight}}px;"></view>
  <view class="nav-bar" style="height: {{navBarHeight}}px;">
    <view class="nav-back" bindtap="goBack">
      <image src="/images/SVG/返回.svg" mode="aspectFit" class="nav-back-icon"></image>
    </view>
  </view>
  <view class="container">
    <view class="login-brand">
      <image class="login-logo" src="/images/tab-home-active.png" mode="aspectFit"></image>
      <text class="text-3xl text-bold">登录 CampusX</text>
      <text class="login-subtitle">使用你的微信账号安全登录</text>
    </view>

    <view class="privacy-box mt-30">
      <text class="text-bold">真实微信身份登录</text>
      <text class="text-sm text-secondary mt-10">登录时会使用微信提供的一次性凭证识别你的账号，不会向小程序暴露微信密码。</text>
      <view class="divider mt-20 mb-20"></view>
      <text class="text-bold">头像和昵称</text>
      <text class="text-sm text-secondary mt-10">首次登录后，可直接选择微信头像并使用微信昵称作为默认资料。</text>
    </view>

    <button class="btn btn-wechat mt-30" bindtap="wechatLogin" loading="{{isLoggingIn}}" disabled="{{isLoggingIn}}">
      <text>{{isLoggingIn ? '登录中...' : '微信一键登录'}}</text>
    </button>

    <view class="agreement mt-30 text-center">
      <text class="text-xs text-secondary">点击登录即表示你已阅读并同意服务协议与隐私政策</text>
    </view>
  </view>
</view>
