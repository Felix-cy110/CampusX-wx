/* 登录页面 */
.page {
  min-height: 100vh;
  background: var(--color-bg);
}

/* 自定义导航栏 */
.nav-bar {
  display: flex;
  align-items: center;
  padding: 0 20rpx;
  position: relative;
}

.nav-back {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 64rpx;
  height: 64rpx;
}

.nav-back-icon {
  width: 40rpx;
  height: 40rpx;
}

.container {
  padding: 60rpx 30rpx;
}

.login-brand {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx 0 28rpx;
}

.login-logo {
  width: 128rpx;
  height: 128rpx;
  margin-bottom: 28rpx;
}

.login-subtitle {
  margin-top: 16rpx;
  font-size: var(--font-sm);
  color: var(--color-text-secondary);
}

.privacy-box {
  background: var(--color-bg-white);
  border-radius: var(--radius-md);
  padding: 24rpx;
}
.privacy-box text {
  display: block;
}
.btn-wechat {
  width: 100%;
  border: 0;
  background-color: var(--color-wechat-green);
  color: #FFFFFF;
}

.btn-wechat::after {
  border: 0;
}

.btn-wechat[disabled] {
  background-color: var(--color-wechat-green);
  color: #FFFFFF;
  opacity: 0.65;
}

.agreement {
  padding: 0 60rpx;
}
