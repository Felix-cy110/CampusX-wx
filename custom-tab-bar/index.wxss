.tab-bar {
  display: flex;
  justify-content: space-around;
  align-items: center;
  padding: 12rpx 0;
  padding-bottom: constant(safe-area-inset-bottom);
  padding-bottom: env(safe-area-inset-bottom);
  background-color: #FFFFFF;
  border-top: 1rpx solid #E6E6E6;
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  z-index: 10001;
  box-sizing: border-box;
  -webkit-transform: translateZ(0);
  transform: translateZ(0);
  will-change: transform;
}

.tab-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
  padding: 8rpx 0;
  flex: 1;
  transition: transform 0.2s ease;
}

.tab-item:active {
  transform: scale(0.92);
}

.tab-icon-wrap {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
}

.tab-icon {
  width: 52rpx;
  height: 52rpx;
  opacity: 0.45;
  filter: grayscale(0.6);
  transition: opacity 0.25s ease, transform 0.25s ease, filter 0.25s ease;
}

.tab-text {
  font-size: 24rpx;
  color: #999999;
  transition: color 0.25s ease, font-weight 0.25s ease;
}

.tab-text.active {
  color: #255AC5;
  font-weight: 600;
}

.tab-item .tab-icon.active-icon {
  opacity: 1;
  transform: scale(1.08);
  filter: grayscale(0);
}

.tab-badge {
  position: absolute;
  top: -8rpx;
  right: -16rpx;
  min-width: 32rpx;
  height: 32rpx;
  padding: 0 8rpx;
  background: #FF7878;
  color: #FFFFFF;
  font-size: 20rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 600;
}

/* 中间发布按钮 */
.publish-btn {
  width: 105rpx;
  height: 105rpx;
  border-radius: 50%;
  background-color: #255AC5;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(37, 90, 197, 0.4);
  flex-shrink: 0;
  margin: 0 8rpx;
}

.publish-btn:active {
  opacity: 0.85;
  transform: scale(0.95);
}

.publish-btn-inner {
  width: 36rpx;
  height: 36rpx;
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
}

.publish-line {
  position: absolute;
  background-color: #FFFFFF;
  border-radius: 3rpx;
  transition: transform 0.3s ease;
}

.publish-line-h {
  width: 36rpx;
  height: 6rpx;
}

.publish-line-v {
  width: 6rpx;
  height: 36rpx;
}

.publish-btn-inner.active .publish-line-h {
  width: 36rpx;
  height: 6rpx;
  transform: rotate(45deg);
}

.publish-btn-inner.active .publish-line-v {
  width: 36rpx;
  height: 6rpx;
  transform: rotate(-45deg);
}

/* 发布弹出层 */
.publish-popup {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 10000;
  pointer-events: none;
}

.publish-popup.visible {
  pointer-events: auto;
}

.publish-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.4);
  opacity: 0;
  transition: opacity 0.3s ease;
}

.publish-popup.visible .publish-mask {
  opacity: 1;
}

.publish-content {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  top: 0;
  background: #F5F5F5;
  border-radius: 0;
  transform: translateY(100%);
  transition: transform 0.35s cubic-bezier(0.32, 0.72, 0, 1);
  display: flex;
  flex-direction: column;
  padding: 0 30rpx 40rpx;
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
}

.publish-popup.visible .publish-content {
  transform: translateY(0);
}

.status-bar-placeholder {
  flex-shrink: 0;
  background: #F5F5F5;
}

.publish-nav {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 96rpx;
  flex-shrink: 0;
}

.publish-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #000000;
}

.publish-placeholder {
  width: 72rpx;
}

.publish-section {
  display: block;
  font-size: 22rpx;
  color: #000000;
  margin-top: 20rpx;
  margin-bottom: 24rpx;
  font-weight: 500;
}

.publish-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
  flex-shrink: 0;
}

.publish-card {
  height: 280rpx;
  background: #FFFFFF;
  border-radius: 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 14rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.publish-card:active {
  opacity: 0.75;
  transform: scale(0.97);
  transition: all 0.1s;
}

.publish-card-icon-wrap {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.publish-card-icon {
  width: 60rpx;
  height: 60rpx;
  opacity: 0.95;
}

.publish-card-label {
  font-size: 30rpx;
  font-weight: 600;
  color: #000000;
}

.publish-card-desc {
  font-size: 20rpx;
  color: #A6A6A6;
  margin-top: 4rpx;
}

.publish-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  flex-shrink: 0;
}

.publish-item {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 32rpx 28rpx;
  background: #FFFFFF;
  border-radius: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.publish-item:active {
  opacity: 0.75;
}

.publish-item-icon {
  width: 52rpx;
  height: 52rpx;
  flex-shrink: 0;
  opacity: 0.85;
}

.publish-item-info {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.publish-item-label {
  font-size: 30rpx;
  font-weight: 600;
  color: #000000;
}

.publish-item-desc {
  font-size: 20rpx;
  color: #A6A6A6;
}

.publish-loading {
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(245,245,245,0.85);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 10;
}

.publish-loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 6rpx solid #e0e0e0;
  border-top-color: #255AC5;
  border-radius: 50%;
  animation: spin 0.7s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}
